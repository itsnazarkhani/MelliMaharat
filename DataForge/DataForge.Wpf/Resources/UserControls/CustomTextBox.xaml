<UserControl x:Class="DataForge.Wpf.Resources.UserControls.CustomTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DataForge.Wpf.Resources.UserControls"
             xmlns:cd="clr-namespace:DataForge.Wpf.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="200"
             Background="White"
             x:Name="Root"
             Validation.ErrorTemplate="{x:Null}"
             GotFocus="Root_GotFocus"
             LostFocus="Root_LostFocus"
             FontSize="20"
             FontFamily="{StaticResource SFProRounded}">

    <StackPanel Margin="10">

        <Border x:Name="mainBorder"
                Style="{StaticResource CustomBorderStyle}"
                BorderBrush="{Binding ElementName=Root, Path=(Validation.HasError), Converter={StaticResource BoolToSolidColorBrushConverter}}"
                MouseDown="mainBorder_MouseDown">

            <Border.Effect>
                <DropShadowEffect x:Name="borderShadow" Color="{Binding ElementName=Root, Path=(Validation.HasError), Converter={StaticResource BoolToColorConverter}}"
                                  BlurRadius="15"
                                  Opacity="0"
                                  ShadowDepth="0"/>
            </Border.Effect>

            <Border.Triggers>
                <EventTrigger RoutedEvent="GotFocus">
                    <BeginStoryboard>
                        <Storyboard Storyboard.TargetName="borderShadow">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.2">
                                
                            </DoubleAnimation>
                        </Storyboard>

                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="LostFocus">
                    <BeginStoryboard>
                        <Storyboard Storyboard.TargetName="borderShadow">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="0"
                         Duration="0:0:0.2">

                            </DoubleAnimation>
                        </Storyboard>

                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>


            <Grid Margin="5" MinHeight="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                
                <TextBlock x:Name="lblTag"
                           Grid.Row="0"
                           Grid.RowSpan="2"
                           Style="{StaticResource TagTextBlockStyle}"
                           Text="{Binding ElementName=Root, Path=Tag}"
                           FontSize="{Binding ElementName=Root, Path=FontSize}">
                    
                    <TextBlock.RenderTransform> 
                        <TransformGroup>
                            <TranslateTransform/>
                            <ScaleTransform/>
                        </TransformGroup>
                    </TextBlock.RenderTransform>

                </TextBlock>

                <TextBox x:Name="txtInput"
                         Grid.Row="1"
                         FontSize="{Binding ElementName=Root, Path=FontSize}"
                         Style="{StaticResource MainTextBoxStyle}"
                         Text="{Binding ElementName=Root, Path=InputText, UpdateSourceTrigger=PropertyChanged}"/>

            </Grid>
        </Border>


        <TextBlock x:Name="lblError"
                   Style="{StaticResource ErrorTextBlockStyle}"
                   Visibility="{Binding ElementName=Root, Path=(Validation.HasError), Converter={StaticResource BoolToVisibilityConverter}}"
                   Text="{Binding ElementName=Root, Path=(Validation.Errors), Converter={StaticResource ValidationResultsToStringConverter}}"
                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>

    </StackPanel>



</UserControl>
