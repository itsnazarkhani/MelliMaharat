<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:CustomControls="clr-namespace:DataForge.Wpf.Resources.UserControls">
    
    <!-- Styles -->
    <Style TargetType="{x:Type CustomControls:CustomTextBox}">
        <Setter Property="Width" Value="250"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style TargetType="Window" x:Key="LoginWindowStyle">
        <Setter Property="DataContext" Value="{StaticResource AuthenticationViewModel}"/>
        <Setter Property="Title" Value="AuthenticateWindow"/>
        <Setter Property="Height" Value="450"/>
        <Setter Property="MinHeight" Value="450"/>
        <Setter Property="Width" Value="800"/>
        <Setter Property="MinWidth" Value="400"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="FontFamily" Value="{StaticResource SFProRounded}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="Background" Value="{StaticResource LoginWindowBackground}"/>
    </Style>
    <Style TargetType="Border" x:Key="LoginWindowMainBorder">
        <Setter Property="Background" Value="White"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="370"/>
        <Setter Property="MinWidth" Value="300"/>
        <Setter Property="MaxWidth" Value="300"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="40"
                                  ShadowDepth="0"
                                  Opacity="0.4">
                </DropShadowEffect>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBlock" x:Key="LoginWindowFirstHeader">
        <Setter Property="Margin" Value="0 20 0 10"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="LoginWindowSecondHeader">
        <Setter Property="Margin" Value="0 0 0 10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style TargetType="StackPanel" x:Key="LoginWindowBodyStackPanel">
        <Setter Property="Margin" Value="15 10 15 0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style TargetType="StackPanel" x:Key="LoginWindowFooterStackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0 0 0 25"/>
    </Style>
    <Style TargetType="Button" x:Key="SignInButton">
        <Setter Property="Width" Value="175"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0 0 0 15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="FontSize" Value="17.5"/>
        <Setter Property="Background" Value="MediumAquamarine"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                    Height="{TemplateBinding Height}"
                    Width="{TemplateBinding Width}"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    CornerRadius="12.5">
                        <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock" x:Key="LoginWindowFooterTextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    
    <!-- Storyboards -->
    <Storyboard x:Key="btnSignInMouseEnterStoryBoard"
                Storyboard.TargetName="btnSignInGlowAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="1"
                         Duration="0:0:0.2">
        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="btnSignInMouseLeaveStoryBoard"
                Storyboard.TargetName="btnSignInGlowAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="0"
                         Duration="0:0:0.2">
        </DoubleAnimation>
    </Storyboard>


</ResourceDictionary>