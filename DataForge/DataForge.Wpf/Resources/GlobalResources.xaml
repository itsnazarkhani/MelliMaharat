<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:CustomControls="clr-namespace:DataForge.Wpf.Resources.UserControls"
                    xmlns:local="clr-namespace:DataForge.Wpf.Commands">
    
    <!-- Colors -->
    <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070"/>
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#FFBEE6FD"/>
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1"/>
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FFC4E5F6"/>
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF2C628B"/>
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4"/>
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5"/>
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383"/>
    <Color x:Key="Button.Pressed.Border.Color">#FF3C7FB1</Color>

    <!-- Styles -->
    <Style TargetType="{x:Type CustomControls:CustomTextBox}">
        <Setter Property="Width" Value="250"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" StrokeDashArray="1 2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" SnapsToDevicePixels="true" StrokeThickness="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WindowStateButtonBase" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Width" Value="45"/>
        <Setter Property="Height" Value="30"/>
    </Style>
    <Style x:Key="MinimizeButton" TargetType="Button" BasedOn="{StaticResource WindowStateButtonBase}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="true">

                        <ContentPresenter x:Name="contentPresenter"
                                          Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="border" Value="Blue"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#550000FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ExitButton" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowStateButtonBase}">
        <Setter Property="Margin" Value="0.5 0 0 0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="true">
                        
                        <ContentPresenter x:Name="contentPresenter"
                                          Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="border" Value="DarkRed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EFFF0000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Window" x:Key="LoginWindowStyle">
        <Setter Property="DataContext" Value="{StaticResource AuthenticationViewModel}"/>
        <Setter Property="Title" Value="AuthenticateWindow"/>
        <Setter Property="Height" Value="450"/>
        <Setter Property="MinHeight" Value="450"/>
        <Setter Property="Width" Value="800"/>
        <Setter Property="MinWidth" Value="400"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="FontFamily" Value="{StaticResource SFProRounded}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="Background" Value="{StaticResource LoginWindowBackground}"/>
    </Style>
    <Style TargetType="Border" x:Key="LoginWindowMainBorder">
        <Setter Property="Background" Value="White"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="370"/>
        <Setter Property="MinWidth" Value="300"/>
        <Setter Property="MaxWidth" Value="300"/>
        <Setter Property="CornerRadius" Value="25"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="40"
                                  ShadowDepth="0"
                                  Opacity="0.4">
                </DropShadowEffect>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBlock" x:Key="LoginWindowFirstHeader">
        <Setter Property="Margin" Value="0 20 0 10"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="LoginWindowSecondHeader">
        <Setter Property="Margin" Value="0 0 0 10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style TargetType="StackPanel" x:Key="LoginWindowBodyStackPanel">
        <Setter Property="Margin" Value="15 10 15 0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style TargetType="StackPanel" x:Key="LoginWindowFooterStackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0 0 0 25"/>
    </Style>
    <Style TargetType="Button" x:Key="SignInButton">
        <Setter Property="Width" Value="175"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0 0 0 15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="FontSize" Value="17.5"/>
        <Setter Property="Background" Value="MediumAquamarine"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                    Height="{TemplateBinding Height}"
                    Width="{TemplateBinding Width}"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    CornerRadius="12.5">
                        <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock" x:Key="LoginWindowFooterTextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style BasedOn="{StaticResource SignInButton}" TargetType="Button" x:Key="DialogBoxButton">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="100" />
    </Style>
    
    <!-- Storyboards -->
    <Storyboard x:Key="btnSignInMouseEnterStoryBoard"
                Storyboard.TargetName="btnSignInGlowAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="1"
                         Duration="0:0:0.2">
        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="btnSignInMouseLeaveStoryBoard"
                Storyboard.TargetName="btnSignInGlowAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="0"
                         Duration="0:0:0.2">
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="RoleSelectionDialogBoxButtonStudentDropShadowEffectGlowBegin"
                Storyboard.TargetName="RoleSelectionDialogBoxButtonStudentDropShadowEffect"
                Storyboard.TargetProperty="Opacity">
        <DoubleAnimation To="1"
                         Duration="0:0:0.2">

        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="RoleSelectionDialogBoxButtonStudentDropShadowEffectGlowEnd"
                Storyboard.TargetName="RoleSelectionDialogBoxButtonStudentDropShadowEffect"
                Storyboard.TargetProperty="Opacity">
        <DoubleAnimation To="0"
                         Duration="0:0:0.2">

        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="RoleSelectionDialogBoxButtonMasterDropShadowEffectGlowBegin"
                Storyboard.TargetName="RoleSelectionDialogBoxButtonMasterDropShadowEffect"
                Storyboard.TargetProperty="Opacity">
        <DoubleAnimation To="1"
                         Duration="0:0:0.2">

        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="RoleSelectionDialogBoxButtonMasterDropShadowEffectGlowEnd"
                Storyboard.TargetName="RoleSelectionDialogBoxButtonMasterDropShadowEffect"
                Storyboard.TargetProperty="Opacity">
        <DoubleAnimation To="0"
                         Duration="0:0:0.2">

        </DoubleAnimation>
    </Storyboard>


    <!-- Images -->
    <Image x:Key="ExitImage"
           Source="/Resources/Images/icons8-close-48.png"
           RenderTransformOrigin="0.5 0.5">
        <Image.RenderTransform>
            <ScaleTransform ScaleX="0.65" ScaleY="0.65"/>
        </Image.RenderTransform>
    </Image>
    <Image x:Key="MinimizeImage"
           Source="/Resources/Images/icons8-minus-48.png"
           RenderTransformOrigin="0.5 0.5"
           SnapsToDevicePixels="True">
        <Image.RenderTransform>
            <ScaleTransform ScaleX="0.6" ScaleY="0.48"/>
        </Image.RenderTransform>
    </Image>

</ResourceDictionary>