<Window x:Class="DataForge.Wpf.Windows.AuthenticateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataForge.Wpf.Windows"
        xmlns:mv="clr-namespace:DataForge.Wpf.ViewModels"
        xmlns:uc="clr-namespace:DataForge.Wpf.Resources.UserControls"
        xmlns:converters="clr-namespace:DataForge.Wpf.Converters"
        mc:Ignorable="d"
        Background="White"
        Title="AuthenticateWindow" Height="450" Width="800">

    <Window.Resources>
        <converters:ValidationErrorsToTextConverter x:Key="MyConverter"/>
    </Window.Resources>
    
    <Window.DataContext>
        <mv:AuthenticateWindowVM/>
    </Window.DataContext>

    <Grid>
        <StackPanel VerticalAlignment="Center">
            <uc:CustomTextBox Margin="10"
                              x:Name="txtUsername"
                              InputText="{Binding Username}"
                              ToolTip="Username TextBox"/>
           
        </StackPanel>
    </Grid>
</Window>
