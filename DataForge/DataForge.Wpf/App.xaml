<Application x:Class="DataForge.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DataForge.Wpf"
             StartupUri="./Windows/AuthenticateWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>


                <ResourceDictionary Source="/Resources/Converters.xaml"/>
                <ResourceDictionary Source="/Resources/UserControls.xaml"/>
                <ResourceDictionary Source="/Resources/DataContexts.xaml"/>
                <ResourceDictionary Source="/Resources/CustomTextBoxStyles.xaml"/>


            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
