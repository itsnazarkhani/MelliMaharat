<Window x:Class="MelliMaharat.Wpf.Windows.MasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MelliMaharat.Wpf.Windows"
        mc:Ignorable="d"
        Background="MediumSeaGreen"
        FontWeight="Bold"
        FontFamily="{StaticResource SFProRounded}"
        Title="MasterWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="15 30">

            <Label Style="{StaticResource LogoLabel}"/>

            <Button Style="{StaticResource MenuItemButton}"
                    Content="Profile"/>
            
            <Button Style="{StaticResource MenuItemButton}"
                    Content="Lessons"/>

            <Button Style="{StaticResource MenuItemButton}"
                    Content="Presentations"/>

            <Button Style="{StaticResource MenuItemButton}"
                    Content="Students"/>

        </StackPanel>

        <Border Grid.Column="1"
                Style="{StaticResource MenuBorder}">
            <Frame Name="MainFrame"
                   Source="Pages/Master/StudentsPage.xaml"/>
        </Border>

        
    </Grid>
</Window>
