<Window x:Class="MelliMaharat.Wpf.Windows.MasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MelliMaharat.Wpf.Windows"
        mc:Ignorable="d"
        Title="MasterWindow"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ManagerWindowStyle}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="15 30">

            <Label Style="{StaticResource LogoLabel}" DockPanel.Dock="Top"/>

            <Separator Opacity="0.5"/>

            <RadioButton Style="{StaticResource MenuItemRadioButton}"
                         Content="Profile"
                         IsChecked="True"/>

            <RadioButton Style="{StaticResource MenuItemRadioButton}"
                         Content="Lessons"/>

            <RadioButton Style="{StaticResource MenuItemRadioButton}"
                         Content="Presentations"/>

        </StackPanel>


        <Border Grid.Column="1"
                Style="{StaticResource MenuBorder}">

            <Frame Name="MainFrame"
                   Source="Pages/Student/ProfilePage.xaml"/>

        </Border>

    </Grid>

</Window>
