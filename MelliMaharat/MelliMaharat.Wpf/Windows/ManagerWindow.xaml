<Window x:Class="MelliMaharat.Wpf.Windows.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MelliMaharat.Wpf.Windows"
        mc:Ignorable="d"
        Title="ManagerWindow"
        Height="550"
        Width="805"
        Background="{StaticResource Deep Space Blue}"
        FontFamily="{StaticResource SFProRounded}"
        FontWeight="Bold">


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                   Margin="15 30">

            <Label Style="{StaticResource LogoLabel}" DockPanel.Dock="Top"/>
            <Separator Opacity="0.5"/>
            <RadioButton Style="{StaticResource MenuItemRadioButton}"
             Content="Profile" IsChecked="True"/>

                <RadioButton Style="{StaticResource MenuItemRadioButton}"
             Content="Masters"/>

                <RadioButton Style="{StaticResource MenuItemRadioButton}"
             Content="Students"/>

                <RadioButton Style="{StaticResource MenuItemRadioButton}"
             Content="Lessons"/>

                <RadioButton Style="{StaticResource MenuItemRadioButton}"
             Content="Presentations"/>

                <RadioButton Style="{StaticResource MenuItemRadioButton}"
             Content="Selections"/>

            
            <!--<Button Style="{StaticResource MenuItemButton}"
                    Content="Profile"/>

            <Button Style="{StaticResource MenuItemButton}"
                    Content="Masters"/>

            <Button Style="{StaticResource MenuItemButton}"
                    Content="Students"/>

            <Button Style="{StaticResource MenuItemButton}"
                    Content="Lessons"/>

            <Button Style="{StaticResource MenuItemButton}"
                    Content="Presentations"/>

            <Button Style="{StaticResource MenuItemButton}"
                    Content="Selections"/>-->

        </StackPanel>

        <Border Grid.Column="1"
                Style="{StaticResource MenuBorder}">

            <!--<ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">-->
            <Frame Name="MainFrame"
                       Source="Pages/Manager/ProfilePage.xaml"/>
            <!--</ScrollViewer>-->

        </Border>

    </Grid>


</Window>
