<Window x:Class="MelliMaharat.Wpf.Windows.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MelliMaharat.Wpf.Windows"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ManagerWindowStyle}"
        Name="Root">


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="15 30">

            <Label Style="{StaticResource LogoLabel}" DockPanel.Dock="Top"/>
            
            <Separator Opacity="0.5"/>
            
            <RadioButton Content="Profile"
                         IsChecked="True"
                         Command="{Binding ProfileCommand}"/>

            <RadioButton Content="Masters"
                         Command="{Binding MastersCommand}"/>

            <RadioButton Content="Students"
                         Command="{Binding StudentsCommand}"/>

            <RadioButton Content="Lessons"
                         Command="{Binding LessonsCommand}"/>

            <RadioButton Content="Presentations"
                         Command="{Binding PresentationsCommand}"/>

            <RadioButton Content="Selections"
                         Command="{Binding SelectionsCommand}"/>

        </StackPanel>

        <Border Grid.Column="1"
                Style="{StaticResource MenuBorder}">

            <Frame Name="MainFrame" NavigationUIVisibility="Hidden"/>
            
        </Border>

    </Grid>


</Window>
