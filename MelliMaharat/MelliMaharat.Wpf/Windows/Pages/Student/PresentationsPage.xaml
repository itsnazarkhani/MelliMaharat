<Page x:Class="MelliMaharat.Wpf.Windows.Pages.Student.PresentationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:custom="clr-namespace:MelliMaharat.Wpf.Resources.UserControls"
      xmlns:local="clr-namespace:MelliMaharat.Wpf.Windows.Pages.Student"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="800"
      Name="Root">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <DockPanel Margin="10" LastChildFill="False">

                    <Grid DockPanel.Dock="Top">
                        <Ellipse Style="{StaticResource Profile_Outer_Ellipse}"/>
                        <Ellipse Fill="WhiteSmoke" Style="{StaticResource Profile_Inner_Ellipse}"/>
                    </Grid>

                    <custom:CustomTextBox InputText="{Binding MasterName}" 
                                          Tag="Master:" 
                                          IsEnabled="False"
                                          DockPanel.Dock="Top"/>

                    <custom:CustomTextBox InputText="{Binding LessonName}" 
                                          Tag="Lesson:" 
                                          IsEnabled="False"
                                          DockPanel.Dock="Top"/>

                    <custom:CustomTextBox InputText="{Binding DayHold}" 
                                          Tag="Day Hold:" 
                                          IsEnabled="False"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox InputText="{Binding StartTime, UpdateSourceTrigger=LostFocus}" 
                                          Tag="Start Time:"
                                          IsEnabled="False"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox InputText="{Binding EndTime, UpdateSourceTrigger=LostFocus}" 
                                          Tag="End Time:" 
                                          IsEnabled="False"
                                          DockPanel.Dock="Top"/>

                    <WrapPanel HorizontalAlignment="Center" DockPanel.Dock="Bottom">
                        <!--<Button Content="Delete" Command="{Binding DeleteCommand}"/>
                        <Button Content="Add" Command="{Binding AddCommand}"/>-->
                        <Button Content="Clear" Click="Clear_Button_Click"/>
                    </WrapPanel>

                </DockPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">

                <TextBlock Text="Presentations"
                           Style="{StaticResource PageDescriptorTextBlock}"
                           DockPanel.Dock="Left"/>

                <ComboBox DockPanel.Dock="Right"
                          ItemsSource="{Binding OrderByOptions}"
                          SelectedItem="{Binding SelectedOrderBy, Mode=TwoWay}"
                          SelectedIndex="0"/>

                <TextBlock DockPanel.Dock="Right" Style="{StaticResource OrderByTextBlock}"/>

            </DockPanel>


            <ListBox Grid.Row="1"
                     Name="listbox"
                     ItemsSource="{Binding Models}"
                     SelectedItem="{Binding Model, Mode=TwoWay}"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                
                <ListBox.ItemTemplate>
                    <DataTemplate>


                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="5*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left">

                                <Ellipse Style="{StaticResource ListBox_OuterEllipse}"/>

                                <Ellipse Style="{StaticResource ListBox_InnerEllipse}" Fill="WhiteSmoke"/>

                            </Grid>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Style="{StaticResource ListBoxItem_Main_TextBlock}"
                                           Text="{Binding Lesson.Name}"/>

                                <TextBlock Style="{StaticResource ListBoxItem_Sub_TextBlock}"
                                           Text="{Binding DayHold, StringFormat=DayHold: {0}}"/>

                            </StackPanel>
                        </Grid>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>


        </Grid>

    </Grid>
</Page>
