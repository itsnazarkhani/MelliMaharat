<Page x:Class="MelliMaharat.Wpf.Windows.Pages.Student.PresentationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:custom="clr-namespace:MelliMaharat.Wpf.Resources.UserControls"
      xmlns:local="clr-namespace:MelliMaharat.Wpf.Windows.Pages.Student"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="800"
      Name="Root">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          DataContext="{Binding Master}">

                <DockPanel DataContext="{Binding ElementName=listbox, Path=SelectedItem}" Margin="10" LastChildFill="False">

                    <Grid DockPanel.Dock="Top">
                        <Ellipse Style="{StaticResource Profile_Outer_Ellipse}"/>
                        <Ellipse Fill="WhiteSmoke" Style="{StaticResource Profile_Inner_Ellipse}"/>
                    </Grid>

                    <custom:CustomTextBox InputText="{Binding MasterName}" Tag="Master:" DockPanel.Dock="Top"/>
                    <custom:CustomTextBox InputText="{Binding LessonName}" Tag="Lesson:" DockPanel.Dock="Top"/>
                    <custom:CustomTextBox InputText="{Binding DayHold}" Tag="Day Hold:" DockPanel.Dock="Top"/>
                    <custom:CustomTextBox InputText="{Binding StartTime}" Tag="Start Time:" DockPanel.Dock="Top"/>
                    <custom:CustomTextBox InputText="{Binding EndTime}" Tag="End Time:" DockPanel.Dock="Top"/>
                    <custom:CustomTextBox InputText="{Binding MasterId}" Tag="Master Id:" DockPanel.Dock="Top"/>
                    <custom:CustomTextBox InputText="{Binding LessonId}" Tag="Lesson Id:" DockPanel.Dock="Top"/>
                    <custom:CustomTextBox InputText="{Binding Id}" Tag="Presentation Id:" IsEnabled="False" DockPanel.Dock="Top"/>

                    <WrapPanel HorizontalAlignment="Center" DockPanel.Dock="Bottom">
                        <Button Content="Delete"/>
                        <Button Content="Add"/>
                        <Button Content="Update"/>
                        <Button Content="Change Picture"/>
                        <Button Content="Clear"/>
                    </WrapPanel>

                </DockPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">

                <TextBlock Text="Presentations"
                           Style="{StaticResource PageDescriptorTextBlock}"
                           DockPanel.Dock="Left"/>

                <ComboBox DockPanel.Dock="Right"
                          SelectedIndex="0">
                    <ComboBoxItem Content="First Name"/>
                    <ComboBoxItem Content="Last Name"/>
                    <ComboBoxItem Content="Age"/>
                </ComboBox>

                <TextBlock DockPanel.Dock="Right" Style="{StaticResource OrderByTextBlock}"/>

            </DockPanel>


            <ListBox Grid.Row="1" Name="listbox">
                <ListBox.ItemTemplate>
                    <DataTemplate>


                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="5*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left">

                                <Ellipse Style="{StaticResource ListBox_OuterEllipse}"/>

                                <Ellipse Style="{StaticResource ListBox_InnerEllipse}" Fill="WhiteSmoke"/>

                            </Grid>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Style="{StaticResource ListBoxItem_Main_TextBlock}">

                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="FirstName"/>
                                            <Binding Path="LastName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>

                                </TextBlock>

                                <TextBlock Style="{StaticResource ListBoxItem_Sub_TextBlock}" Text="{Binding Age, StringFormat=Age: {0}}"/>

                            </StackPanel>
                        </Grid>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>


        </Grid>

    </Grid>
</Page>
