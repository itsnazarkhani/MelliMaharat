<Page x:Class="MelliMaharat.Wpf.Windows.Pages.Manager.MastersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MelliMaharat.Wpf.Windows.Pages.Manager"
      xmlns:custom="clr-namespace:MelliMaharat.Wpf.Resources.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="1200" d:DesignWidth="800"
      Name="Root">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <DockPanel Margin="10" LastChildFill="False">

                    <Grid DockPanel.Dock="Top">
                        <Ellipse Style="{StaticResource Profile_Outer_Ellipse}"/>
                        <Ellipse Fill="{StaticResource MasterIconBrush}" Style="{StaticResource Profile_Inner_Ellipse}"/>
                    </Grid>

                    <custom:CustomTextBox InputText="{Binding FirstName}"
                                          Tag="First Name:"
                                          DockPanel.Dock="Top"
                                          x:Name="txtFirstName"/>
                    
                    <custom:CustomTextBox InputText="{Binding LastName}"
                                          Tag="Last Name:"
                                          DockPanel.Dock="Top"/>

                    <custom:CustomTextBox InputText="{Binding Birthdate}"
                                          Tag="Birthdate:"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox InputText="{Binding NationalCode}"
                                          Tag="National Code:"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox InputText="{Binding PhoneNumber}"
                                          Tag="Phone Number:"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox InputText="{Binding Email}"
                                          Tag="Email:"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox InputText="{Binding Password}"
                                          Tag="Password:"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox InputText="{Binding IsAdmin}"
                                          Tag="Is Admin:"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox InputText="{Binding Username}"
                                          Tag="Username:"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox InputText="{Binding Graduation}"
                                          Tag="Graduation:"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox InputText="{Binding Role}"
                                          Tag="Role:"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox InputText="{Binding Id}"
                                          IsEnabled="False"
                                          Tag="Id:"
                                          DockPanel.Dock="Top"/>
                    <custom:CustomTextBox InputText="{Binding Department}"
                                          IsEnabled="False"
                                          Tag="Department:"
                                          DockPanel.Dock="Top"/>
                    
                    <WrapPanel HorizontalAlignment="Center" DockPanel.Dock="Bottom">
                        <Button Content="Delete"/>
                        <Button Content="Add"/>
                        <Button Content="Update"/>
                        <Button Content="Change Picture"/>
                        <Button Content="Clear"/>
                    </WrapPanel>

                </DockPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">

                <TextBlock Text="Masters"
                           Style="{StaticResource PageDescriptorTextBlock}"
                           DockPanel.Dock="Left"/>

                <ComboBox DockPanel.Dock="Right"
                          SelectedIndex="0">
                    <ComboBoxItem Content="First Name"/>
                    <ComboBoxItem Content="Last Name"/>
                    <ComboBoxItem Content="Age"/>
                </ComboBox>

                <TextBlock DockPanel.Dock="Right" Style="{StaticResource OrderByTextBlock}"/>

            </DockPanel>


            <ListBox Grid.Row="1"
                     Name="listbox"
                     ItemsSource="{Binding Models}"
                     SelectedItem="{Binding Model, Mode=TwoWay}"
                     ScrollViewer.CanContentScroll="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                
                <ListBox.ItemTemplate>
                    <DataTemplate>


                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="5*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left">

                                <Ellipse Style="{StaticResource ListBox_OuterEllipse}"/>

                                <Ellipse Style="{StaticResource ListBox_InnerEllipse}" Fill="{StaticResource MasterIconBrush}"/>

                            </Grid>

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Style="{StaticResource ListBoxItem_Main_TextBlock}">

                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="User.PersonInformation.FirstName"/>
                                            <Binding Path="User.PersonInformation.LastName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>

                                </TextBlock>

                                <TextBlock Style="{StaticResource ListBoxItem_Sub_TextBlock}"
                                           Text="{Binding Department.Name, StringFormat=Department: {0}}"/>

                            </StackPanel>
                        </Grid>

                    </DataTemplate>
                    
                </ListBox.ItemTemplate>

            </ListBox>


        </Grid>

    </Grid>
    
</Page>
