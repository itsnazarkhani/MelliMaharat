    <Style TargetType="Button" x:Key="SignInButton">
        <Setter Property="Width" Value="175"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0 0 0 15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="FontSize" Value="17.5"/>
        <Setter Property="Background" Value="{StaticResource Deep Space Blue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        Height="{TemplateBinding Height}"
                        Width="{TemplateBinding Width}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        CornerRadius="12.5"
                        MinWidth="{TemplateBinding MinWidth}"
                        MinHeight="{TemplateBinding MinHeight}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="shadowEffect"
                                              ShadowDepth="0"
                                              BlurRadius="20"
                                              Opacity="0"
                                              Color="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background, Converter={StaticResource BrushToColorConverter}}"/>
                        </Border.Effect>

                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="shadowEffect"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="shadowEffect"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton" x:Key="MenuItemRadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0 10" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Width" Value="auto" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0"
                          BlurRadius="20"
                          Opacity="0.3"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="17.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border CornerRadius="15"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}">


                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>


                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="{StaticResource Deep Space Blue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SignInButton}" x:Key="MenuItemButton">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0 10" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <!--<Setter Property="Background" Value="WhiteSmoke" />-->
        <Setter Property="MinWidth" Value="130" />
        <Setter Property="Width" Value="auto" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <!--<Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0"
                                  BlurRadius="20"
                                  Opacity="0.3"/>
            </Setter.Value>
        </Setter>-->
    </Style>
    <Style TargetType="TextBlock" x:Key="LoginWindowFooterTextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style BasedOn="{StaticResource SignInButton}" TargetType="Button" x:Key="DialogBoxButton">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="100" />
    </Style>
    <Style TargetType="Border"
           x:Key="MenuBorder">
        <Setter Property="Margin" Value="15" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="WhiteSmoke" />
        <Setter Property="CornerRadius" Value="25" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0"
                                  BlurRadius="30"
                                  Opacity="0.3"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Label" x:Key="LogoLabel">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Content" Value="Melli Maharat" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0 0 0 20" />
    </Style>
    
    <!-- Storyboards -->
    <Storyboard x:Key="btnSignInMouseEnterStoryBoard"
                Storyboard.TargetName="btnSignInGlowAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="1"
                         Duration="0:0:0.2">
        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="btnSignInMouseLeaveStoryBoard"
                Storyboard.TargetName="btnSignInGlowAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="0"
                         Duration="0:0:0.2">
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="RoleSelectionDialogBoxButtonStudentDropShadowEffectGlowBegin"
                Storyboard.TargetName="RoleSelectionDialogBoxButtonStudentDropShadowEffect"
                Storyboard.TargetProperty="Opacity">
        <DoubleAnimation To="1"
                         Duration="0:0:0.2">

        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="RoleSelectionDialogBoxButtonStudentDropShadowEffectGlowEnd"
                Storyboard.TargetName="RoleSelectionDialogBoxButtonStudentDropShadowEffect"
                Storyboard.TargetProperty="Opacity">
        <DoubleAnimation To="0"
                         Duration="0:0:0.2">

        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="RoleSelectionDialogBoxButtonMasterDropShadowEffectGlowBegin"
                Storyboard.TargetName="RoleSelectionDialogBoxButtonMasterDropShadowEffect"
                Storyboard.TargetProperty="Opacity">
        <DoubleAnimation To="1"
                         Duration="0:0:0.2">

        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="RoleSelectionDialogBoxButtonMasterDropShadowEffectGlowEnd"
                Storyboard.TargetName="RoleSelectionDialogBoxButtonMasterDropShadowEffect"
                Storyboard.TargetProperty="Opacity">
        <DoubleAnimation To="0"
                         Duration="0:0:0.2">

        </DoubleAnimation>
    </Storyboard>


