@model MelliMaharat.Web.ViewModels.Admin.TermViewModel

@{
    ViewData["Title"] = "افزودن ترم جدید";
}

<div class="container mt-4">

    <h2 class="mb-4">افزودن ترم جدید</h2>

    <form method="post" asp-action="AddNewTerm" class="card p-4 shadow">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                لطفاً خطاهای زیر را بررسی کنید.
            </div>
        }

        <div class="mb-3">
            <label class="form-label">سال</label>
            <input asp-for="Year" class="form-control" />
            <span asp-validation-for="Year" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">نوع ترم</label>
            <select asp-for="Type" class="form-select">
                @foreach (var item in Enum.GetValues(typeof(TermType)).Cast<TermType>())
                {
                    <option value="@item"
                            selected="@(Model.Type == item ? "selected" : null)">
                        @item.GetDescription()
                    </option>
                }
            </select>

        </div>

        <div class="mb-3">
            <label class="form-label">زمان شروع</label>
            <input asp-for="StartTime" class="form-control" type="date" />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">زمان پایان</label>
            <input asp-for="EndTime" class="form-control" type="date" />
            <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="TermsList" class="btn btn-secondary">بازگشت</a>
            <button type="submit" class="btn btn-primary">ثبت ترم</button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
