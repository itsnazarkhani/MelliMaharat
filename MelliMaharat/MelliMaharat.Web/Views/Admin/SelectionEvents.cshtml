@model IEnumerable<MelliMaharat.Models.SelectionTime>

@{
    ViewData["Title"] = "لیست رویدادها";

    // Define theme colors for the design, consistent with other Admin pages
    var primaryColor = "#004488"; // Deep Corporate Blue
    var accentColor = "#0056b3";  // Slightly darker primary for hover
    var successColor = "#28a745"; // Success green for 'Add' action
    var successAccent = "#218838"; // Darker green for hover
    var dangerColor = "#dc3545"; // Danger red for 'Delete' action
    var dangerAccent = "#c82333"; // Darker red for hover

    // *******************************************************************
    // NOTE: This helper function is assumed to be available in the context.
    // If not, it needs to be defined as a static method or a Razor Helper.
    // This is the implementation logic for demonstrating Persian numbers:
    // *******************************************************************
    string ToPersianNumber(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        return input.Replace('0', '۰').Replace('1', '۱').Replace('2', '۲')
                    .Replace('3', '۳').Replace('4', '۴').Replace('5', '۵')
                    .Replace('6', '۶').Replace('7', '۷').Replace('8', '۸')
                    .Replace('9', '۹');
    }
}

<style>
    /*
         * Styling for the body element is avoided as requested.
         */

    .page-header {
        color: @primaryColor;
        font-weight: 800;
        border-bottom: 3px solid @primaryColor;
        padding-bottom: 10px;
        margin-bottom: 30px;
        display: inline-block;
        width: 100%;
    }

    /* --- Table Styling --- */
    .table-container {
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        overflow-x: auto; /* Ensures responsiveness on small screens */
        background-color: white;
        border: 1px solid #e9ecef;
    }

    .table-styled {
        margin: 0;
        width: 100%;
        min-width: 650px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-styled thead {
            background-color: @primaryColor;
            color: white;
        }

        .table-styled th {
            font-weight: 600;
            padding: 15px 12px;
            text-align: right;
            border: none;
            vertical-align: middle;
            font-size: 0.95rem;
        }

        .table-styled td {
            padding: 12px;
            border-top: 1px solid #f1f1f1;
            text-align: right;
            vertical-align: middle;
            white-space: nowrap;
            /* Ensure Persian font is used for correct rendering of numbers */
            font-family: Tahoma, 'B Titr', 'B Nazanin', Arial, sans-serif;
        }

        .table-styled tbody tr:hover {
            background-color: #f7f9fc;
            cursor: default;
        }

    /* --- Action Button Styles (Add Event) --- */
    .btn-add-styled {
        background-color: @successColor;
        border-color: @successColor;
        color: white;
        font-weight: bold;
        padding: 8px 20px;
        border-radius: 8px;
        transition: all 0.2s;
        min-width: 120px;
    }

        .btn-add-styled:hover {
            background-color: @successAccent;
            border-color: @successAccent;
            transform: translateY(-1px);
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

    /* Delete Button Styling */
    .btn-delete-styled {
        background-color: @dangerColor;
        border-color: @dangerColor;
        color: white;
        font-weight: 500;
        padding: 6px 15px;
        border-radius: 6px;
        transition: all 0.2s;
        font-size: 0.9rem;
    }

        .btn-delete-styled:hover {
            background-color: @dangerAccent;
            border-color: @dangerAccent;
        }
</style>

<div class="container py-5" dir="rtl">

    <h2 class="page-header">
        <i class="fas fa-calendar-alt ms-2"></i>
        لیست رویدادهای انتخاب واحد
    </h2>

    <div class="d-flex justify-content-end mb-4">
        <a asp-action="AddSelectionEvent" class="btn btn-add-styled">
            <i class="fas fa-plus ms-2"></i>
            افزودن رویداد
        </a>
    </div>

    <div class="table-container">
        <table class="table table-styled">
            <thead>
                <tr>
                    <th>شروع انتخاب واحد</th>
                    <th>پایان انتخاب واحد</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var evt in Model)
                    {
                        <tr>
                            <!-- Convert Date/Time strings to Persian numbers -->
                            <td>@ToPersianNumber(evt.SelectionStart.ToString("yyyy/MM/dd HH:mm"))</td>
                            <td>@ToPersianNumber(evt.SelectionEnd.ToString("yyyy/MM/dd HH:mm"))</td>
                            <td>
                                <form asp-action="DeleteSelectionEvent" asp-route-id="@evt.Id" method="post">
                                    <!-- NOTE: Do NOT use browser's native confirm() in production.
                                         Implement a custom modal UI for confirmation instead. -->
                                    <button type="submit" class="btn btn-sm btn-danger btn-delete-styled">
                                        <i class="fas fa-trash-alt ms-1"></i>
                                        حذف
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            هیچ رویداد انتخاب واحدی ثبت نشده است.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>