@model IEnumerable<MelliMaharat.Models.Student>

@{
    ViewData["Title"] = "دانشجویان";

    // Define theme colors for the design, consistent with other Admin pages
    var primaryColor = "#004488"; // Deep Corporate Blue
    var accentColor = "#0056b3";  // Slightly darker primary for hover
    var successColor = "#28a745"; // Success green for 'Add' action
    var successAccent = "#218838"; // Darker green for hover
}

<style>
    /*
         * Styling for the body element is avoided as requested.
         */

    .page-header {
        color: @primaryColor;
        font-weight: 800;
        border-bottom: 3px solid @primaryColor;
        padding-bottom: 10px;
        margin-bottom: 30px;
        display: inline-block;
        width: 100%;
    }

    /* --- Table Styling --- */
    .table-container {
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        overflow-x: auto; /* Ensures responsiveness on small screens */
        background-color: white;
        border: 1px solid #e9ecef;
    }

    .table-styled {
        margin: 0;
        width: 100%;
        min-width: 700px; /* Minimum width for table content */
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-styled thead {
            background-color: @primaryColor;
            color: white;
        }

        .table-styled th {
            font-weight: 600;
            padding: 15px 12px;
            text-align: right;
            border: none;
            vertical-align: middle;
        }

        .table-styled td {
            padding: 12px;
            border-top: 1px solid #f1f1f1;
            text-align: right;
            vertical-align: middle;
        }

        .table-styled tbody tr:hover {
            background-color: #f7f9fc;
            cursor: default;
        }

    /* --- Action Button Styles --- */
    /* Add Button (Success/Green) */
    .btn-add-styled {
        background-color: @successColor;
        border-color: @successColor;
        color: white;
        font-weight: bold;
        padding: 8px 20px;
        border-radius: 8px;
        transition: all 0.2s;
        min-width: 120px;
    }

        .btn-add-styled:hover {
            background-color: @successAccent;
            border-color: @successAccent;
            transform: translateY(-1px);
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

    /* View Button (Primary/Blue) - Used for operations in table */
    .btn-view-styled {
        background-color: @primaryColor;
        border-color: @primaryColor;
        color: white;
        font-weight: 500;
        padding: 6px 15px;
        border-radius: 6px;
        transition: all 0.2s;
        font-size: 0.9rem;
    }

        .btn-view-styled:hover {
            background-color: @accentColor;
            border-color: @accentColor;
        }
</style>

<div class="container py-5" dir="rtl">

    <h2 class="page-header">
        <i class="fas fa-users ms-2"></i>
        لیست دانشجویان
    </h2>

    <div class="d-flex justify-content-end mb-4">
        <a asp-action="AddStudent" class="btn btn-add-styled">
            <i class="fas fa-plus ms-2"></i>
            افزودن دانشجو
        </a>
    </div>

    <div class="table-container">
        <table class="table table-styled">
            <thead>
                <tr>
                    <th>نام</th>
                    <th>نام خانوادگی</th>
                    <th>کد ملی</th>
                    <th>تاریخ تولد</th>
                    <th>شماره تماس</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.User.PersonInformation.FirstName</td>
                            <td>@student.User.PersonInformation.LastName</td>
                            <td>@student.User.PersonInformation.NationalCode</td>
                            <td>@student.User.PersonInformation.BirthDate.ToString("yyyy/MM/dd")</td>
                            <td>@student.User.PersonInformation.PhoneNumber</td>
                            <td>
                                <!-- Optional: link to view student profile -->
                                <a class="btn btn-view-styled" asp-controller="Admin" asp-action="StudentDetails" asp-route-id="@student.Id">
                                    <i class="fas fa-eye ms-1"></i>
                                    مشاهده
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            هیچ دانشجویی ثبت نشده است.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>