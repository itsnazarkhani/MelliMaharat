@model MelliMaharat.Models.Master

@{
    // Define theme colors
    var primaryColor = "#004488"; // Deep Corporate Blue
    var secondaryColor = "#6c757d"; // Secondary Gray
    var textDark = "#212529";     // Dark text
    var backgroundColor = "#e9ecef"; // Very Light Gray Page Background

    ViewData["Title"] = "افزودن استاد";
}

<style>
    body {
        background-color: @backgroundColor;
        font-family: Tahoma, Arial, sans-serif;
    }

    .form-card {
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        border: none;
        background-color: white;
    }

    .main-header {
        color: @primaryColor;
        font-weight: 900;
        border-bottom: 3px solid @primaryColor;
        padding-bottom: 15px;
        margin-bottom: 30px;
    }

    .section-header {
        color: @textDark;
        font-weight: 800;
        margin-top: 25px;
        margin-bottom: 15px;
        padding-bottom: 5px;
        border-bottom: 1px dashed #ccc;
    }

    .form-label {
        color: @textDark;
        font-weight: bold;
    }

    .form-control, .form-select {
        border-radius: 6px;
    }

        .form-control:focus, .form-select:focus {
            border-color: @primaryColor;
            box-shadow: 0 0 0 0.25rem rgba(0, 68, 136, 0.25);
        }

    .btn-primary-styled {
        background-color: @primaryColor;
        border-color: @primaryColor;
        color: white;
        font-weight: bold;
        transition: all 0.2s;
        border-radius: 6px;
    }

        .btn-primary-styled:hover {
            background-color: #003366;
            border-color: #003366;
            transform: translateY(-1px);
        }

    .btn-secondary-styled {
        background-color: @secondaryColor;
        border-color: @secondaryColor;
        color: white;
        font-weight: bold;
        border-radius: 6px;
    }
</style>

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <!-- Main Header -->
            <h3 class="main-header">
                <i class="fas fa-chalkboard-teacher me-2"></i>
                افزودن استاد جدید
            </h3>

            <!-- Form Card -->
            <form method="post" asp-controller="Admin" asp-action="AddMaster" class="form-card p-4 p-md-5">

                <!-- ---------------------- PERSONAL INFORMATION ---------------------- -->
                <h5 class="section-header">
                    <i class="fas fa-user-circle me-1"></i> اطلاعات شخصی
                </h5>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label class="form-label"><i class="fas fa-font me-1"></i> نام</label>
                        <input name="person.FirstName" class="form-control" required placeholder="نام استاد" />
                        <!-- Assuming Validation Messages are shown via ValidationSummary or Tag Helpers if available -->
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="form-label"><i class="fas fa-signature me-1"></i> نام خانوادگی</label>
                        <input name="person.LastName" class="form-control" required placeholder="نام خانوادگی استاد" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label class="form-label"><i class="fas fa-calendar-alt me-1"></i> تاریخ تولد</label>
                        <input name="person.BirthDate" type="date" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-4">
                        <label class="form-label"><i class="fas fa-id-card me-1"></i> کد ملی</label>
                        <input name="person.NationalCode" class="form-control" required placeholder="۰۱۲۳۴۵۶۷۸۹" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label"><i class="fas fa-phone me-1"></i> شماره تماس</label>
                    <input name="person.PhoneNumber" class="form-control" required placeholder="۰۹۱۲۳۴۵۶۷۸۹" />
                </div>

                <!-- ---------------------- MASTER INFORMATION ---------------------- -->
                <h5 class="section-header">
                    <i class="fas fa-graduation-cap me-1"></i> اطلاعات استاد
                </h5>

                <div class="mb-4">
                    <label asp-for="Graduation" class="form-label"><i class="fas fa-book me-1"></i> رشته تحصیلی</label>
                    <input asp-for="Graduation" class="form-control" required placeholder="مثال: مهندسی کامپیوتر" />
                </div>

                <div class="mb-4">
                    <label asp-for="DepartmentId" class="form-label"><i class="fas fa-building me-1"></i> دانشکده</label>
                    <select asp-for="DepartmentId" class="form-select" required>
                        <option value="">-- انتخاب دانشکده --</option>
                        @if (ViewBag.Departments != null)
                        {
                            @foreach (var dep in ViewBag.Departments)
                            {
                                <option value="@dep.Id">@dep.Name</option>
                            }
                        }
                    </select>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-3 mt-5">
                    <a class="btn btn-secondary-styled px-4" asp-action="Masters">
                        <i class="fas fa-arrow-right me-1"></i> بازگشت
                    </a>
                    <button type="submit" class="btn btn-primary-styled px-4">
                        <i class="fas fa-save me-1"></i> ذخیره اطلاعات
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>