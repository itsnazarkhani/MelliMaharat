@model List<MelliMaharat.Models.Master>

@{
    ViewData["Title"] = "لیست اساتید";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>اساتید</h3>
    <a class="btn btn-success"
       asp-controller="Admin"
       asp-action="AddMaster">
        افزودن استاد +
    </a>
</div>

<div style="max-height: 500px; overflow-y: auto;">
    <table class="table table-bordered table-striped text-center">
        <thead class="table-dark">
            <tr>
                <th>نام و نام خانوادگی</th>
                <th>کد ملی</th>
                <th>شماره تماس</th>
                <th>رشته تحصیلی</th>
                <th>دانشکده</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var master in Model)
            {
                <tr>
                    <td>@master.User.PersonInformation.FirstName @master.User.PersonInformation.LastName</td>
                    <td>@master.User.PersonInformation.NationalCode</td>
                    <td>@master.User.PersonInformation.PhoneNumber</td>
                    <td>@master.Graduation</td>
                    <td>@master.Department?.Name</td>
                </tr>
            }
        </tbody>
    </table>
</div>
