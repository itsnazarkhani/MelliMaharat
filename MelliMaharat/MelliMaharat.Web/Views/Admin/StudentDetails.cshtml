@model StudentDetailsViewModel

@{
    ViewData["Title"] = "جزئیات دانشجو";
}

<h3 class="mb-3">جزئیات دانشجو</h3>

<div class="card p-4" style="max-width: 600px;">
    <div class="d-flex mb-3 align-items-center">
        <img src="@Model.AvatarPath" class="rounded-circle me-3" style="width: 80px; height: 80px; object-fit: cover;" />
        <h4 class="mb-0">@Model.FirstName @Model.LastName</h4>
    </div>

    <dl class="row">
        <dt class="col-sm-4">کد ملی:</dt>
        <dd class="col-sm-8">@Model.NationalCode</dd>

        <dt class="col-sm-4">تاریخ تولد:</dt>
        <dd class="col-sm-8">@Model.BirthDate.ToString("yyyy/MM/dd")</dd>

        <dt class="col-sm-4">شماره تماس:</dt>
        <dd class="col-sm-8">@Model.PhoneNumber</dd>
    </dl>

    <div class="text-end">
        <a asp-action="Students" class="btn btn-secondary">بازگشت به لیست</a>
    </div>
</div>
