@model StudentDetailsViewModel

@{
    ViewData["Title"] = "جزئیات دانشجو";

    // Define theme colors for the design, consistent with other Admin pages
    var primaryColor = "#004488"; // Deep Corporate Blue
    var accentColor = "#0056b3";  // Slightly darker primary for hover
    var secondaryColor = "#6c757d"; // Gray
    var dividerColor = "#e9ecef"; // Light gray divider
}

<style>
    /*
         * Styling for the body element is avoided as requested.
         */

    .page-header {
        color: @primaryColor;
        font-weight: 800;
        border-bottom: 3px solid @primaryColor;
        padding-bottom: 10px;
        margin-bottom: 30px;
        display: inline-block;
        width: 100%;
    }

    .detail-card {
        max-width: 600px;
        width: 100%;
        background-color: white;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        padding: 30px;
        border: 1px solid @dividerColor;
        margin-left: auto;
        margin-right: auto;
    }

    /* Style for the profile image and name container */
    .profile-header {
        border-bottom: 1px solid @dividerColor;
        padding-bottom: 20px;
        margin-bottom: 25px;
        align-items: center;
        display: flex;
    }

    /* Avatar styling */
    .profile-avatar {
        width: 90px;
        height: 90px;
        object-fit: cover;
        border: 4px solid @primaryColor; /* Accent border around avatar */
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .profile-name {
        color: @primaryColor;
        font-weight: 700;
        margin: 0;
        font-size: 1.6rem;
    }

    /* Styling for the details list (dl) */
    .detail-list dt {
        font-weight: bold;
        color: @secondaryColor;
        padding: 8px 0;
        border-bottom: 1px dotted #f1f1f1;
    }

    .detail-list dd {
        padding: 8px 0;
        border-bottom: 1px dotted #f1f1f1;
        font-weight: 500;
        color: #333;
    }

    /* Secondary Button Style (Back) - Consistent with other pages */
    .btn-secondary-styled {
        background-color: #e9ecef;
        border: 1px solid #ced4da;
        color: @secondaryColor;
        font-weight: bold;
        padding: 10px 25px;
        border-radius: 8px;
        transition: all 0.2s;
        min-width: 120px;
    }

        .btn-secondary-styled:hover {
            background-color: #dee2e6;
            transform: translateY(-1px);
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
        }
</style>

<div class="container py-5" dir="rtl">

    <h2 class="page-header">
        <i class="fas fa-id-card-alt ms-2"></i>
        جزئیات دانشجو
    </h2>

    <div class="detail-card">

        <!-- Profile Header: Avatar and Name -->
        <div class="profile-header">
            <img src="@Model.AvatarPath" class="rounded-circle ms-4 profile-avatar"
                 onerror="this.onerror=null;this.src='https://placehold.co/90x90/ccc/white?text=S'"
                 alt="تصویر پروفایل" />
            <h4 class="profile-name">@Model.FirstName @Model.LastName</h4>
        </div>

        <!-- Details List -->
        <dl class="row detail-list">
            <dt class="col-sm-5">
                <i class="fas fa-id-badge ms-2 text-primary"></i>
                کد ملی:
            </dt>
            <dd class="col-sm-7">@Model.NationalCode</dd>

            <dt class="col-sm-5">
                <i class="fas fa-calendar-alt ms-2 text-primary"></i>
                تاریخ تولد:
            </dt>
            <dd class="col-sm-7">@Model.BirthDate.ToString("yyyy/MM/dd")</dd>

            <dt class="col-sm-5">
                <i class="fas fa-phone ms-2 text-primary"></i>
                شماره تماس:
            </dt>
            <dd class="col-sm-7">@Model.PhoneNumber</dd>

            <!-- Add more details here if available in the view model -->
        </dl>

        <!-- Action Button -->
        <div class="text-start mt-4 pt-3">
            <a asp-action="Students" class="btn btn-secondary-styled">
                <i class="fas fa-arrow-right ms-2"></i>
                بازگشت به لیست
            </a>
        </div>
    </div>
</div>