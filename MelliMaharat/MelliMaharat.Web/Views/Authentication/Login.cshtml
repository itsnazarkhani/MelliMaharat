@model LoginViewModel

@{
    // Define theme colors
    var primaryColor = "#004488"; // Deep Corporate Blue
    var textDark = "#212529";     // Dark text
    var backgroundColor = "#e9ecef"; // Very Light Gray Page Background

    ViewData["Title"] = "ورود به سیستم";
}

<style>
    body {
        background-color: @backgroundColor;
        font-family: Tahoma, Arial, sans-serif;
    }

    .login-container {
        /* Center content vertically and horizontally */
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh;
    }

    .login-card {
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        border: none;
        overflow: hidden; /* Contains the colored header */
    }

    .card-header-styled {
        background-color: @primaryColor;
        color: white;
        padding: 1.5rem;
        border-bottom: none;
        border-radius: 12px 12px 0 0;
    }

    .form-control:focus {
        border-color: @primaryColor;
        box-shadow: 0 0 0 0.25rem rgba(0, 68, 136, 0.25);
    }

    .btn-primary-styled {
        background-color: @primaryColor;
        border-color: @primaryColor;
        color: white; /* Changed: Ensure text is white for high contrast */
        font-weight: bold;
        transition: background-color 0.3s, transform 0.2s;
        border-radius: 8px;
    }

        .btn-primary-styled:hover {
            background-color: #003366;
            border-color: #003366;
            transform: translateY(-1px);
        }

    .alert-danger {
        border-right: 4px solid #dc3545;
        border-left: none; /* For RTL look */
    }
</style>

<div class="login-container" dir="rtl">
    <div class="row justify-content-center w-100">
        <div class="col-lg-4 col-md-6 col-sm-8">
            <div class="card login-card">

                <div class="card-header-styled text-center">
                    <h3 class="card-title mb-0 fw-bold">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        ورود به سیستم
                    </h3>
                </div>

                <div class="card-body p-4 p-md-5">

                    <!-- Validation Summary -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @Html.ValidationSummary()
                        </div>
                    }

                    <form method="post" action="/Authentication/Login">
                        @Html.AntiForgeryToken()

                        <!-- Username Field -->
                        <div class="mb-4">
                            <label for="username" class="form-label fw-bold" style="color: @textDark;">
                                <i class="fas fa-user me-2"></i>
                                نام کاربری
                            </label>
                            <input type="text" class="form-control" id="username" name="username" required
                                   placeholder="لطفاً نام کاربری خود را وارد نمایید..." />
                        </div>

                        <!-- Password Field -->
                        <div class="mb-4">
                            <label for="password" class="form-label fw-bold" style="color: @textDark;">
                                <i class="fas fa-lock me-2"></i>
                                رمز عبور
                            </label>
                            <input type="password" class="form-control" id="password" name="password" required
                                   placeholder="لطفاً رمز عبور خود را وارد نمایید..." />
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary-styled btn-lg">
                                <i class="fas fa-arrow-alt-circle-left me-2"></i>
                                ورود
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>