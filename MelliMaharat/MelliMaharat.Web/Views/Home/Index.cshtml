@{
    ViewData["Title"] = "ملی مهارت";
}

<link rel="stylesheet" href="~/css/home.css" />

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <div class="hero-divider"></div>
        <h1 class="hero-title">
            <i class="fas fa-newspaper me-3"></i>اخبار و مقالات
        </h1>
        <p class="hero-subtitle">
            آخرین اخبار، اطلاعات و مقالات علمی از دانشکده ملی مهارت چمران
        </p>

        <div class="hero-image-container">
            <img src="~/images/home-banner.png"
                 alt="اخبار و مقالات"
                 class="hero-image" />
        </div>
    </div>
</section>

<!-- News Cards Section -->
<section class="news-section">
    <div class="container-fluid px-3 px-lg-4">
        <h2 class="text-center mb-4" style="font-size: 2.2rem; font-weight: 700; color: var(--text-dark);">
            آخرین اخبار
        </h2>

        <div class="news-grid">
            <!-- News Card 1 -->
            <article class="news-card">
                <img src="~/images/news-1.png" alt="عنوان خبر" class="news-card-image" />
                <div class="news-card-body">
                    <div class="news-card-date">
                        <i class="fas fa-calendar-alt"></i>
                        1404/09/15
                    </div>
                    <h3 class="news-card-title">
                        افتتاح دوره آموزشی جدید
                    </h3>
                    <p class="news-card-description">
                        دانشکده ملی مهارت چمران افتخار می‌کند اعلام کند که دوره آموزشی جدید در زمینه فناوری اطلاعات آغاز شده است.
                    </p>
                    <div class="news-card-footer">
                        <span class="news-card-category">آموزش</span>
                        <a href="#" class="news-card-link">
                            بیشتر
                            <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>
                </div>
            </article>

            <!-- News Card 2 -->
            <article class="news-card">
                <img src="~/images/news-2.png" alt="عنوان خبر" class="news-card-image" />
                <div class="news-card-body">
                    <div class="news-card-date">
                        <i class="fas fa-calendar-alt"></i>
                        1404/09/10
                    </div>
                    <h3 class="news-card-title">
                        همایش بین‌المللی دانشجویان
                    </h3>
                    <p class="news-card-description">
                        برگزاری موفق همایش بین‌المللی دانشجویان با حضور دانشمندان از کشورهای مختلف جهان.
                    </p>
                    <div class="news-card-footer">
                        <span class="news-card-category">رویدادها</span>
                        <a href="#" class="news-card-link">
                            بیشتر
                            <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>
                </div>
            </article>

            <!-- News Card 3 -->
            <article class="news-card">
                <img src="~/images/news-3.png" alt="عنوان خبر" class="news-card-image" />
                <div class="news-card-body">
                    <div class="news-card-date">
                        <i class="fas fa-calendar-alt"></i>
                        1404/09/05
                    </div>
                    <h3 class="news-card-title">
                        تحقیقات جدید در رشته‌های مختلف
                    </h3>
                    <p class="news-card-description">
                        اعضای هیات علمی دانشکده نتایج تحقیقات جدید خود را در مجلات علمی منتشر کردند.
                    </p>
                    <div class="news-card-footer">
                        <span class="news-card-category">تحقیق</span>
                        <a href="#" class="news-card-link">
                            بیشتر
                            <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>
                </div>
            </article>
        </div>

        <div class="text-center mt-5">
            <a href="#" class="cta-button">
                <i class="fas fa-external-link-alt me-2"></i>مشاهده تمام اخبار
            </a>
        </div>
    </div>
</section>

<!-- Statistics Section -->
<section class="stats-section">
    <div class="stats-grid">
        <div class="stat-item">
            <div class="stat-number">5000+</div>
            <div class="stat-label">دانشجو</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">150+</div>
            <div class="stat-label">مقاله علمی</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">50+</div>
            <div class="stat-label">دوره آموزشی</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">100%</div>
            <div class="stat-label">رضایت دانشجویان</div>
        </div>
    </div>
</section>