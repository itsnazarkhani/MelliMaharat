@model MelliMaharat.Web.ViewModels.User.ChangePasswordViewModel

@{
    ViewData["Title"] = "تغییر رمز عبور";

    // Define theme colors using C# variables for use in inline styles
    var primaryColor = "#1e3a8a"; // --primary-color (Dark Blue)
    var accentColor = "#f59e0b";  // --accent-color (Orange/Amber)
    var textDark = "#1f2937";    // --text-dark
}

<div class="container mt-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <h3 class="mb-4 fw-bold text-center" style="color: @primaryColor;">تغییر رمز عبور</h3>

            @if (TempData["IncorrectCurrentPassword"] != null)
            {
                <div class="alert alert-danger text-center">
                    @TempData["IncorrectCurrentPassword"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div class="alert alert-danger" role="alert">
                    لطفاً خطاهای زیر را اصلاح کنید:
                    @Html.ValidationSummary(false)
                </div>
            }

            <div class="card shadow-lg border-0" style="border-radius: 10px;">
                <div class="card-header border-0 text-white fw-bold py-3" style="background-color: @primaryColor; border-radius: 10px 10px 0 0;">
                    <span class="fs-5">تنظیم رمز عبور جدید</span>
                </div>

                <form method="post" asp-controller="User" asp-action="ChangePassword" class="card-body p-4">

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-bold" style="color: @textDark;"></label>
                        <input asp-for="CurrentPassword" class="form-control form-control-lg" style="border-radius: 6px;" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-bold" style="color: @textDark;"></label>
                        <input asp-for="NewPassword" class="form-control form-control-lg" style="border-radius: 6px;" />
                        <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-bold" style="color: @textDark;"></label>
                        <input asp-for="ConfirmNewPassword" class="form-control form-control-lg" style="border-radius: 6px;" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between gap-3 pt-2">
                        <a class="btn btn-secondary btn-lg flex-grow-1" asp-controller="User" asp-action="Dashboard" style="border-radius: 6px;">
                            بازگشت
                        </a>
                        <button type="submit" class="btn btn-lg flex-grow-1 fw-bold"
                                style="background-color: @accentColor; color: @textDark; border-radius: 6px; border: 1px solid @accentColor;">
                            ذخیره و تغییر رمز
                        </button>
                    </div>
                </form>
            </div>

            <div class="mt-4 alert alert-info text-dark" role="alert" style="border-color: @primaryColor;">
                **توجه:** رمز عبور جدید شما باید حداقل 6 کاراکتر و شامل حروف بزرگ، کوچک و اعداد باشد.
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}