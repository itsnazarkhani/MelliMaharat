@using MelliMaharat.Web.ViewModels.User
@model UserDashboardViewModel
@{
    ViewData["Title"] = "داشبورد";

    // Define theme colors using C# variables for use in inline styles
    // Based on the provided CSS:
    var primaryColor = "#1e3a8a"; // --primary-color (Dark Blue)
    var accentColor = "#f59e0b";  // --accent-color (Orange/Amber)
    var textDark = "#1f2937";    // --text-dark
    var lightBg = "#f8fafc";     // --light-bg
}

<div class="container mt-5" dir="rtl" style="max-width: 900px;">

    <h3 class="mb-5 fw-bold text-center" style="color: @primaryColor;">داشبورد کاربری</h3>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row justify-content-center">

        <div class="col-lg-10 col-md-12 mb-4">
            <div class="card shadow-lg p-4 border-0" style="background-color: #ffffff; border-radius: 10px;">

                <div class="row">

                    <div class="col-md-4 text-center border-md-start border-light border-2 pb-4 pb-md-0" style="border-color: #e5e7eb !important;">

                        <div class="d-inline-block p-1 border rounded-circle mb-3" style="border-width: 4px !important; border-color: @accentColor !important; background-color: @lightBg; width: 140px; height: 140px;">
                            <img src="@(
                                 Model.AvatarId == Guid.Empty
                                     ? "/images/default-avatar.jpg"
                                     : $"/images/uploads/avatars/{Model.AvatarId}.jpg"
                                                                              )"
                                 class="rounded-circle w-100 h-100"
                                 style="object-fit:cover;"
                                 alt="تصویر کاربری" />
                        </div>

                        <h4 class="fw-bold" style="color: @textDark;">@Model.FullName</h4>
                        <span class="badge mb-4 fs-6" style="background-color: @primaryColor; color: #fff; padding: .5em 1em; border-radius: 20px;">@Model.Role</span>

                        <hr class="d-md-none my-3" />

                    </div>

                    <div class="col-md-8">

                        <h5 class="fw-bold mb-3" style="color: @primaryColor;">جزئیات حساب کاربری</h5>
                        <ul class="list-group list-group-flush text-end mb-4">

                            <li class="list-group-item d-flex justify-content-between align-items-center px-0" style="color: @textDark; background-color: transparent;">
                                <span class="fw-bold" style="color: @primaryColor;">شماره تماس:</span>
                                <span>@Model.PhoneNumber</span>
                            </li>

                            <li class="list-group-item d-flex justify-content-between align-items-center px-0" style="color: @textDark; background-color: transparent;">
                                <span class="fw-bold" style="color: @primaryColor;">ایمیل:</span>
                                <span>@Model.Email</span>
                            </li>

                            <li class="list-group-item d-flex justify-content-between align-items-center px-0" style="color: @textDark; background-color: transparent;">
                                <span class="fw-bold" style="color: @primaryColor;">کد ملی:</span>
                                <span>@Model.NationalCode</span>
                            </li>

                            <li class="list-group-item d-flex justify-content-between align-items-center px-0" style="color: @textDark; background-color: transparent;">
                                <span class="fw-bold" style="color: @primaryColor;">تاریخ تولد:</span>
                                <span>@Model.BirthDate</span>
                            </li>
                        </ul>

                        <hr class="my-3" />

                        <div class="d-flex flex-column flex-sm-row justify-content-between gap-3 mt-4">

                            <a asp-controller="User" asp-action="EditProfile" class="btn flex-grow-1 fw-bold"
                               style="background-color: @primaryColor; color: #fff; border-radius: 6px; border: 1px solid @primaryColor;">
                                ویرایش پروفایل
                            </a>

                            <a asp-controller="User" asp-action="ChangePassword" class="btn flex-grow-1 fw-bold"
                               style="background-color: @accentColor; color: @textDark; border-radius: 6px; border: 1px solid @accentColor;">
                                تغییر رمز عبور
                            </a>

                            <form asp-controller="Authentication" asp-action="Logout" method="post" class="flex-grow-1">
                                <button type="submit" class="btn btn-danger w-100 fw-bold" style="border-radius: 6px;">خروج از حساب</button>
                            </form>

                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>