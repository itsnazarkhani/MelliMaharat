@model List<Selection>
@using MelliMaharat.Models.Enums

@{
    ViewData["Title"] = "سابقه حضور و غیاب";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>
                <i class="fas fa-calendar-check"></i>
                سابقه حضور و غیاب
            </h2>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            شما هنوز هیچ درسی را انتخاب نکرده‌اید.
        </div>
    }
    else
    {
        var groupedSelections = Model.GroupBy(s => new { s.Term.Id, s.Term.Year, s.Term.Type });

        @foreach (var termGroup in groupedSelections.OrderByDescending(g => g.Key.Year).ThenByDescending(g => g.Key.Type))
        {
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-calendar-alt me-2"></i>
                        ترم @termGroup.Key.Year - @(termGroup.Key.Type == TermType.Fall ? "پاییز" : "بهار")
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>نام درس</th>
                                    <th>استاد</th>
                                    <th>کل جلسات</th>
                                    <th>حضور</th>
                                    <th>غیاب</th>
                                    <th>درصد حضور</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var selection in termGroup.OrderBy(s => s.Presentation.Lesson.Name))
                                {
                                    var totalSessions = selection.Sessions.Count();
                                    var presentSessions = selection.Sessions.Count(s => s.Attendance != null && s.Attendance.HasAttended);
                                    var absentSessions = totalSessions - presentSessions;
                                    var attendancePercentage = totalSessions > 0 ? (decimal)presentSessions / totalSessions * 100 : 0;

                                    <tr>
                                        <td><strong>@selection.Presentation.Lesson.Name</strong></td>
                                        <td>
                                            @selection.Presentation.Master.User.PersonInformation.FirstName
                                            @selection.Presentation.Master.User.PersonInformation.LastName
                                        </td>
                                        <td><span class="badge bg-primary">@totalSessions</span></td>
                                        <td><span class="badge bg-success">@presentSessions</span></td>
                                        <td><span class="badge bg-danger">@absentSessions</span></td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress" style="width: 80px; height: 20px;">
                                                    <div class="progress-bar bg-success"
                                                         style="width: @attendancePercentage%;">
                                                    </div>
                                                </div>
                                                <small>@attendancePercentage.ToString("F0")%</small>
                                            </div>
                                        </td>
                                        <td>
                                            <a href="@Url.Action("AttendanceDetails", new { selectionId = selection.Id })"
                                               class="btn btn-sm btn-info">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .card {
        border-right: 4px solid #198754;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 20px;
    }
</style>