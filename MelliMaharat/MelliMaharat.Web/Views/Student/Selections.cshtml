@model List<Selection>
@using MelliMaharat.Models.Enums

@{
    var pageTitle = "واحدهای ترم";
    ViewData["Title"] = pageTitle;

    // Define theme colors
    var primaryColor = "#1e3a8a"; // Dark Blue
    var accentColor = "#f59e0b";  // Orange/Amber
    var textLight = "#ffffff";
    var textDark = "#1f2937";
}

@functions {
    /// <summary>
    /// Converts Latin (English) numerals in a string to Persian (Farsi) numerals.
    /// </summary>
    public string ToPersianNumber(object input)
    {
        if (input == null) return string.Empty;
        string text = input.ToString();

        Dictionary<char, char> mapping = new Dictionary<char, char>
        {
            {'0', '۰'}, {'1', '۱'}, {'2', '۲'}, {'3', '۳'}, {'4', '۴'},
            {'5', '۵'}, {'6', '۶'}, {'7', '۷'}, {'8', '۸'}, {'9', '۹'}
        };

        char[] chars = text.ToCharArray();
        for (int i = 0; i < chars.Length; i++)
        {
            if (mapping.ContainsKey(chars[i]))
            {
                chars[i] = mapping[chars[i]];
            }
        }
        return new string(chars);
    }
}

<!-- Changed container to container-xl for a wider desktop layout -->
<div class="container-xl mt-5" dir="rtl">

    <!-- Header and Action Button -->
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <h2 class="fw-bold" style="color: @primaryColor;">
            <i class="fas fa-list-alt me-2"></i>
            @pageTitle
        </h2>
        <a href="@Url.Action("RegisterSelection")" class="btn btn-lg fw-bold shadow-sm"
           style="background-color: @accentColor; color: @textDark; border: none; border-radius: 8px;">
            <i class="fas fa-plus me-1"></i>
            انتخاب واحد جدید
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="alert alert-info py-4 text-center border-0 shadow-sm" style="background-color: #e3f2fd; color: @primaryColor; border-radius: 8px;">
            <i class="fas fa-info-circle fa-2x mb-3"></i>
            <p class="mb-2 fs-5 fw-bold">هنوز واحد انتخاب نکرده‌اید.</p>
            <a href="@Url.Action("RegisterSelection")" class="alert-link fw-bold" style="color: @accentColor;">
                اقدام به انتخاب واحد از لیست دروس موجود
            </a>
        </div>
    }
    else
    {
        var groupedSelections = Model.GroupBy(s => new { s.Term.Id, s.Term.Year, s.Term.Type });

        @foreach (var termGroup in groupedSelections.OrderByDescending(g => g.Key.Year).ThenByDescending(g => g.Key.Type))
        {
            <!-- Term Group Card -->
            <div class="card mb-5 shadow-lg border-0" style="border-radius: 12px; border-right: 5px solid @primaryColor;">

                <!-- Card Header (Term Info) -->
                <div class="card-header border-0 text-white" style="background-color: @primaryColor; border-radius: 7px 7px 0 0;">
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-calendar-check me-2"></i>
                            ترم @ToPersianNumber(termGroup.Key.Year) - @(termGroup.Key.Type == TermType.Fall ? "پاییز" : "بهار")
                        </h5>
                        <!-- Reduced contrast on button by using primary color and white background -->
                        <a href="@Url.Action("SemesterSelections", new { termId = termGroup.First().TermId })"
                           class="btn btn-sm fw-bold shadow-sm"
                           style="background-color: @textLight; color: @primaryColor; border: 1px solid @primaryColor; border-radius: 5px;">
                            <i class="fas fa-eye me-1"></i>
                            مشاهده جزئیات
                        </a>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <!-- Increased vertical padding in th and td for a bigger table appearance -->
                        <table class="table table-striped table-hover mb-0">
                            <thead style="background-color: #f8f9fa;">
                                <tr>
                                    <th class="py-4">نام واحد</th>
                                    <th class="py-4 text-center">تعداد واحد</th>
                                    <th class="py-4">استاد</th>
                                    <th class="py-4">روز برگزاری</th>
                                    <th class="py-4">ساعت</th>
                                    <th class="py-4 text-center">نمره</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var selection in termGroup.OrderBy(s => s.Presentation.Lesson.Name))
                                {
                                    <tr>
                                        <td class="py-3">
                                            <strong style="color: @primaryColor;">@selection.Presentation.Lesson.Name</strong>
                                        </td>
                                        <td class="py-3 text-center">
                                            <span class="badge" style="background-color: #dee2e6; color: @textDark; border-radius: 20px;">
                                                @ToPersianNumber(selection.Presentation.Lesson.Unit)
                                            </span>
                                        </td>
                                        <td class="py-3">
                                            @selection.Presentation.Master.User.PersonInformation.FirstName @selection.Presentation.Master.User.PersonInformation.LastName
                                        </td>
                                        <td class="py-3">@selection.Presentation.DayHold</td>
                                        <td class="py-3">
                                            @ToPersianNumber(selection.Presentation.StartTime.ToString("HH:mm")) - @ToPersianNumber(selection.Presentation.EndTime.ToString("HH:mm"))
                                        </td>
                                        <td class="py-3 text-center">
                                            @if (selection.Score > 0)
                                            {
                                                <span class="badge text-white fw-bold" style="background-color: #28a745; border-radius: 20px;">
                                                    @ToPersianNumber(selection.Score.ToString("F2"))
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary text-white" style="background-color: #6c757d; border-radius: 20px;">
                                                    نیافتاده
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>