@model List<Selection>
@using MelliMaharat.Models.Enums

@{
    ViewData["Title"] = "واحد‌های انتخابی شده";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>
                <i class="fas fa-list"></i>
                واحد‌های انتخابی شده
            </h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("RegisterSelection")" class="btn btn-primary">
                <i class="fas fa-plus"></i>
                انتخاب واحد جدید
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle me-2"></i>
            هنوز واحد انتخاب نکرده‌اید.
            <a href="@Url.Action("RegisterSelection")" class="alert-link">اقدام به انتخاب واحد</a>
        </div>
    }
    else
    {
        var groupedSelections = Model.GroupBy(s => new { s.Term.Id, s.Term.Year, s.Term.Type });

        @foreach (var termGroup in groupedSelections.OrderByDescending(g => g.Key.Year).ThenByDescending(g => g.Key.Type))
        {
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-calendar-alt me-2"></i>
                            ترم @termGroup.Key.Year - @(termGroup.Key.Type == TermType.Fall ? "پاییز" : "بهار")
                        </h5>
                        <a href="@Url.Action("SemesterSelections", new { termId = termGroup.First().TermId })"
                           class="btn btn-sm btn-light">
                            <i class="fas fa-eye me-1"></i>
                            مشاهده جزئیات
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>نام واحد</th>
                                    <th>تعداد واحد</th>
                                    <th>استاد</th>
                                    <th>روز برگزاری</th>
                                    <th>ساعت</th>
                                    <th>نمره</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var selection in termGroup.OrderBy(s => s.Presentation.Lesson.Name))
                                {
                                    <tr>
                                        <td><strong>@selection.Presentation.Lesson.Name</strong></td>
                                        <td><span class="badge bg-secondary">@selection.Presentation.Lesson.Unit</span></td>
                                        <td>@selection.Presentation.Master.User.PersonInformation.FirstName @selection.Presentation.Master.User.PersonInformation.LastName</td>
                                        <td>@selection.Presentation.DayHold</td>
                                        <td>@selection.Presentation.StartTime.ToString("HH:mm") - @selection.Presentation.EndTime.ToString("HH:mm")</td>
                                        <td>
                                            @if (selection.Score > 0)
                                            {
                                                <span class="badge bg-success">@selection.Score.ToString("F2")</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">نیافتاده</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .card {
        border-right: 4px solid #0d6efd;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 20px;
    }
</style>