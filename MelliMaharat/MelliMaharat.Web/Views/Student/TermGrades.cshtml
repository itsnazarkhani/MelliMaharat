@model TermGradesViewModel

@{
    ViewData["Title"] = $"نمرات ترم {Model.Year}";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>
                <i class="fas fa-book-reader"></i>
                نمرات ترم @Model.Year - @(Model.Type == TermType.Fall ? "پاییز" : "بهار")
            </h2>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <p class="mb-2"><strong>معدل ترم</strong></p>
                    <h3 class="text-primary">@Model.GPA.ToString("F2")</h3>
                    <small class="text-muted">از 20</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <p class="mb-2"><strong>تعداد درس‌ها</strong></p>
                    <h3 class="text-info">@Model.Selections.Count()</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <p class="mb-2"><strong>کل واحد‌ها</strong></p>
                    <h3 class="text-success">@Model.TotalUnits</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <p class="mb-2"><strong>میانگین نمره</strong></p>
                    <h3 class="text-warning">@(Model.Selections.Any() ? Model.Selections.Average(s => s.Score).ToString("F2") : "N/A")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Grades Table -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">جزئیات نمرات</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th style="text-align: right;">نام درس</th>
                            <th style="text-align: right;">استاد</th>
                            <th style="text-align: center;">کد درس</th>
                            <th style="text-align: center;">تعداد واحد</th>
                            <th style="text-align: center;">نمره</th>
                            <th style="text-align: center;">درجه</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var selection in Model.Selections.OrderByDescending(s => s.Score))
                        {
                            var gradeInfo = selection.Score switch
                            {
                                >= 18 => ("A", "success"),
                                >= 16 => ("B", "info"),
                                >= 14 => ("C", "warning"),
                                >= 12 => ("D", "danger"),
                                _ => ("F", "dark")
                            };

                            <tr>
                                <td style="text-align: right;">
                                    <strong>@selection.Presentation.Lesson.Name</strong>
                                </td>
                                <td style="text-align: right;">
                                    @selection.Presentation.Master.User.PersonInformation.FirstName
                                    @selection.Presentation.Master.User.PersonInformation.LastName
                                </td>
                                <td style="text-align: center;">@selection.Presentation.Lesson.Code</td>
                                <td style="text-align: center;">
                                    <span class="badge bg-secondary">@selection.Presentation.Lesson.Unit</span>
                                </td>
                                <td style="text-align: center;">
                                    <strong>@selection.Score.ToString("F2")</strong>
                                </td>
                                <td style="text-align: center;">
                                    <span class="badge bg-@gradeInfo.Item2">@gradeInfo.Item1</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Grade Scale Info -->
    <div class="card mt-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">مقیاس درجات</h5>
        </div>
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-2">
                    <span class="badge bg-success p-2">A: 18-20</span>
                </div>
                <div class="col-md-2">
                    <span class="badge bg-info p-2">B: 16-17.99</span>
                </div>
                <div class="col-md-2">
                    <span class="badge bg-warning p-2">C: 14-15.99</span>
                </div>
                <div class="col-md-2">
                    <span class="badge bg-danger p-2">D: 12-13.99</span>
                </div>
                <div class="col-md-2">
                    <span class="badge bg-dark p-2">F: <12</span>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a href="@Url.Action("Grades")" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i>
            بازگشت به صفحه نمرات
        </a>
    </div>
</div>

<style>
    body {
        direction: rtl;
        text-align: right;
    }

    .card {
        border-right: 4px solid #0d6efd;
    }

    .table {
        margin-bottom: 0;
    }
</style>