@model MelliMaharat.Web.ViewModels.ChoosePresentationsViewModel

@{
    ViewData["Title"] = "انتخاب ارائه‌های ترم";
}

<h2>انتخاب ارائه‌های ترم @Model.TermTitle</h2>

<form method="post">
    <input type="hidden" asp-for="TermId" />

    @if (!Model.Presentations.Any())
    {
        <div class="alert alert-info">هیچ ارائه‌ای برای این ترم وجود ندارد.</div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>درس</th>
                    <th>استاد</th>
                    <th>روز</th>
                    <th>ساعت</th>
                    <th>تاریخ آزمون</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Presentations)
                {
                    <tr>
                        <td>
                            <input type="checkbox" name="SelectedPresentationIds" value="@p.Id" />
                        </td>
                        <td>@p.LessonName</td>
                        <td>@p.MasterName</td>
                        <td>@p.DayHold</td>
                        <td>@p.StartTime - @p.EndTime</td>
                        <td>@p.ExamDate</td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">تایید انتخاب‌ها</button>
    }
</form>
