@model AttendanceDetailsViewModel

@{
    ViewData["Title"] = "جزئیات حضور و غیاب";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>
                <i class="fas fa-clipboard-list"></i>
                جزئیات حضور و غیاب
            </h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("AttendanceHistory")" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i>
                بازگشت
            </a>
        </div>
    </div>

    <!-- Course Information Card -->
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">@Model.LessonName</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <p class="mb-2"><strong>استاد:</strong></p>
                    <p>@Model.MasterName</p>
                </div>
                <div class="col-md-3">
                    <p class="mb-2"><strong>روز برگزاری:</strong></p>
                    <p>@Model.DayHold</p>
                </div>
                <div class="col-md-3">
                    <p class="mb-2"><strong>ترم:</strong></p>
                    <p>@Model.TermName</p>
                </div>
                <div class="col-md-3">
                    <p class="mb-2"><strong>درصد حضور:</strong></p>
                    <p><span class="badge bg-success">@Model.AttendancePercentage%</span></p>
                </div>
            </div>

            <hr>

            <div class="alert alert-info">
                <strong>خلاصه:</strong>
                حضور: <span class="badge bg-success">@Model.PresentSessions</span> |
                غیاب: <span class="badge bg-danger">@(Model.TotalSessions - Model.PresentSessions)</span> |
                کل جلسات: <span class="badge bg-primary">@Model.TotalSessions</span>
            </div>
        </div>
    </div>

    <!-- Sessions Table -->
    <div class="card">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>
                جلسات
            </h5>
        </div>
        <div class="card-body">
            @if (!Model.Sessions.Any())
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    هنوز جلسه‌ای برای این درس ثبت نشده است.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>تاریخ جلسه</th>
                                <th>وضعیت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sessionNumber = 1;
                            }
                            @foreach (var session in Model.Sessions.OrderByDescending(s => s.SessionDate))
                            {
                                <tr>
                                    <td>@sessionNumber</td>
                                    <td>@session.SessionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        @if (session.IsPresent)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check"></i>
                                                حاضر
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times"></i>
                                                غایب
                                            </span>
                                        }
                                    </td>
                                </tr>
                                sessionNumber++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card {
        border-right: 4px solid #0d6efd;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 20px;
    }
</style>