@model SemesterSelectionsViewModel
@using MelliMaharat.Models.Enums

@{
    ViewData["Title"] = "انتخاب‌های ترم";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>
                <i class="fas fa-graduation-cap"></i>
                انتخاب‌های ترم @Model.TermName
            </h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Selections")" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i>
                بازگشت
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title">تعداد درس‌ها</h6>
                    <h3 class="text-primary">@Model.TotalLessons</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title">کل واحد‌ها</h6>
                    <h3 class="text-success">@Model.TotalUnits</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Table -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>
                جزئیات درس‌های انتخابی
            </h5>
        </div>
        <div class="card-body">
            @if (!Model.Selections.Any())
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    هیچ درسی برای این ترم انتخاب نشده است.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>نام درس</th>
                                <th>کد درس</th>
                                <th>واحد</th>
                                <th>استاد</th>
                                <th>روز و ساعت</th>
                                <th>نمره</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var selection in Model.Selections)
                            {
                                <tr>
                                    <td><strong>@selection.Presentation.Lesson.Name</strong></td>
                                    <td>@selection.Presentation.Lesson.Code</td>
                                    <td><span class="badge bg-secondary">@selection.Presentation.Lesson.Unit</span></td>
                                    <td>
                                        @selection.Presentation.Master.User.PersonInformation.FirstName
                                        @selection.Presentation.Master.User.PersonInformation.LastName
                                    </td>
                                    <td>
                                        @selection.Presentation.DayHold<br>
                                        <small class="text-muted">
                                            @selection.Presentation.StartTime.ToString("HH:mm") - @selection.Presentation.EndTime.ToString("HH:mm")
                                        </small>
                                    </td>
                                    <td>
                                        @if (selection.Score > 0)
                                        {
                                            <span class="badge bg-success">@selection.Score.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">نیافتاده</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("AttendanceDetails", new { selectionId = selection.Id })"
                                           class="btn btn-sm btn-info" title="حضور و غیاب">
                                            <i class="fas fa-calendar-check"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card {
        border-right: 4px solid #0d6efd;
    }
</style>