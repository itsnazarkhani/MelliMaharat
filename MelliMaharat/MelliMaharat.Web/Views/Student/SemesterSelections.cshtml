@model SemesterSelectionsViewModel
@using MelliMaharat.Models.Enums

@{
    ViewData["Title"] = "انتخاب‌های ترم";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>
                <i class="fas fa-graduation-cap"></i>
                انتخاب‌های ترم @Model.TermName
            </h2>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Selections")" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i>
                بازگشت
            </a>
        </div>
    </div>

    <!-- Selection Time Status Alert -->
    @if (Model.IsSelectionTime)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-clock me-2"></i>
            <strong>زمان انتخاب واحد فعال است</strong> - @Model.SelectionTimeMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    else
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>زمان انتخاب واحد منقضی شده است</strong> - @Model.SelectionTimeMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title">تعداد درس‌ها</h6>
                    <h3 class="text-primary">@Model.TotalLessons</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title">کل واحد‌ها</h6>
                    <h3 class="text-success">@Model.TotalUnits</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Table with Action Buttons -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>
                جزئیات درس‌های انتخابی
            </h5>
        </div>
        <div class="card-body">
            @if (!Model.Selections.Any())
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    هیچ درسی برای این ترم انتخاب نشده است.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th style="text-align: right;">نام درس</th>
                                <th style="text-align: center;">کد درس</th>
                                <th style="text-align: center;">واحد</th>
                                <th style="text-align: right;">استاد</th>
                                <th style="text-align: right;">روز و ساعت</th>
                                <th style="text-align: center;">نمره</th>
                                @if (Model.IsSelectionTime)
                                {
                                    <th style="text-align: center;">عملیات</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var selection in Model.Selections)
                            {
                                <tr>
                                    <td style="text-align: right;"><strong>@selection.Presentation.Lesson.Name</strong></td>
                                    <td style="text-align: center;">@selection.Presentation.Lesson.Code</td>
                                    <td style="text-align: center;"><span class="badge bg-secondary">@selection.Presentation.Lesson.Unit</span></td>
                                    <td style="text-align: right;">
                                        @selection.Presentation.Master.User.PersonInformation.FirstName
                                        @selection.Presentation.Master.User.PersonInformation.LastName
                                    </td>
                                    <td style="text-align: right;">
                                        @selection.Presentation.DayHold<br>
                                        <small class="text-muted">
                                            @selection.Presentation.StartTime.ToString("HH:mm") - @selection.Presentation.EndTime.ToString("HH:mm")
                                        </small>
                                    </td>
                                    <td style="text-align: center;">
                                        @if (selection.Score > 0)
                                        {
                                            <span class="badge bg-success">@selection.Score.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">نیافتاده</span>
                                        }
                                    </td>
                                    @if (Model.IsSelectionTime)
                                    {
                                        <td style="text-align: center;">
                                            <form method="post" action="@Url.Action("RemoveSelection")" style="display:inline;">
                                                <input type="hidden" name="selectionId" value="@selection.Id" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        title="حذف این واحد"
                                                        onclick="return confirm('آیا مطمئن هستید که می‌خواهید این واحد را حذف کنید؟');">
                                                    <i class="fas fa-trash"></i> حذف
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-4">
        <a href="@Url.Action("Selections")" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i>
            بازگشت
        </a>
        @if (Model.IsSelectionTime)
        {
            <a href="@Url.Action("RegisterSelection")" class="btn btn-primary">
                <i class="fas fa-plus"></i>
                انتخاب واحد جدید
            </a>
        }
    </div>
</div>

<style>
    .card {
        border-right: 4px solid #0d6efd;
    }

    body {
        direction: rtl;
        text-align: right;
    }

    .table {
        text-align: right;
    }
</style>