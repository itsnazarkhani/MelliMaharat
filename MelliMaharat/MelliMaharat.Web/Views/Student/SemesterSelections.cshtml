@model SemesterSelectionsViewModel
@using MelliMaharat.Models.Enums

@{
    ViewData["Title"] = "واحدهای ترم"; // Changed title as requested

    // Define theme colors
    var primaryColor = "#1e3a8a"; // Dark Blue
    var accentColor = "#f59e0b";  // Orange/Amber
    var successColor = "#28a745"; // Green
    var warningColor = "#ffc107"; // Yellow
    var textLight = "#ffffff";
    var textDark = "#1f2937";
}

@functions {
    /// <summary>
    /// Converts Latin (English) numerals in a string to Persian (Farsi) numerals.
    /// </summary>
    public string ToPersianNumber(object input)
    {
        if (input == null) return string.Empty;
        string text = input.ToString();

        Dictionary<char, char> mapping = new Dictionary<char, char>
        {
            {'0', '۰'}, {'1', '۱'}, {'2', '۲'}, {'3', '۳'}, {'4', '۴'},
            {'5', '۵'}, {'6', '۶'}, {'7', '۷'}, {'8', '۸'}, {'9', '۹'},
            {'.', '/'} // Handle decimal point for scores
        };

        char[] chars = text.ToCharArray();
        for (int i = 0; i < chars.Length; i++)
        {
            if (mapping.ContainsKey(chars[i]))
            {
                chars[i] = mapping[chars[i]];
            }
        }
        return new string(chars);
    }
}

<div class="container-xl mt-5" dir="rtl">

    <!-- Header and Back Button -->
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <h2 class="fw-bold" style="color: @primaryColor;">
            <i class="fas fa-graduation-cap me-2"></i>
            جزئیات انتخاب واحد ترم @ToPersianNumber(Model.TermName)
        </h2>
        <a href="@Url.Action("Selections")" class="btn fw-bold shadow-sm"
           style="background-color: @textLight; color: @primaryColor; border: 1px solid @primaryColor; border-radius: 8px;">
            <i class="fas fa-arrow-right me-1"></i>
            بازگشت به لیست واحدهای ترم
        </a>
    </div>

    <!-- Selection Time Status Alert -->
    @if (Model.IsSelectionTime)
    {
        <div class="alert alert-success alert-dismissible fade show fw-bold shadow-sm" role="alert" style="border-right: 5px solid @successColor;">
            <i class="fas fa-clock me-2"></i>
            <strong>زمان انتخاب واحد فعال است</strong> - @Model.SelectionTimeMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    else
    {
        <div class="alert alert-warning alert-dismissible fade show fw-bold shadow-sm" role="alert" style="border-right: 5px solid @warningColor;">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>زمان انتخاب واحد منقضی شده است</strong> - @Model.SelectionTimeMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Transactional Alerts (Success/Error) -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Summary Cards -->
    <div class="row mb-5">
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card text-center shadow-sm border-0" style="border-bottom: 4px solid @primaryColor; border-radius: 8px;">
                <div class="card-body py-4">
                    <h6 class="card-title text-muted fw-bold">تعداد درس‌ها</h6>
                    <h3 class="fw-bolder" style="color: @primaryColor;">
                        @ToPersianNumber(Model.TotalLessons)
                    </h3>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card text-center shadow-sm border-0" style="border-bottom: 4px solid @successColor; border-radius: 8px;">
                <div class="card-body py-4">
                    <h6 class="card-title text-muted fw-bold">کل واحد‌ها</h6>
                    <h3 class="fw-bolder" style="color: @successColor;">
                        @ToPersianNumber(Model.TotalUnits)
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Table with Action Buttons -->
    <div class="card shadow-lg border-0" style="border-radius: 12px; border-right: 5px solid @primaryColor;">
        <div class="card-header border-0 text-white" style="background-color: @primaryColor; border-radius: 7px 7px 0 0;">
            <h5 class="mb-0 fw-bold py-1">
                <i class="fas fa-list-ul me-2"></i>
                جزئیات درس‌های انتخابی
            </h5>
        </div>
        <div class="card-body p-0">
            @if (!Model.Selections.Any())
            {
                <div class="alert alert-info border-0 m-3 text-center" role="alert">
                    <i class="fas fa-info-circle me-2"></i>
                    هیچ درسی برای این ترم انتخاب نشده است.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th class="py-4 text-right">نام درس</th>
                                <th class="py-4 text-center">کد درس</th>
                                <th class="py-4 text-center">واحد</th>
                                <th class="py-4 text-right">استاد</th>
                                <th class="py-4 text-right">روز و ساعت</th>
                                <th class="py-4 text-center">نمره</th>
                                @if (Model.IsSelectionTime)
                                {
                                    <th class="py-4 text-center">عملیات</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var selection in Model.Selections)
                            {
                                <tr>
                                    <td class="py-3 text-right">
                                        <strong style="color: @primaryColor;">@selection.Presentation.Lesson.Name</strong>
                                    </td>
                                    <td class="py-3 text-center">
                                        @ToPersianNumber(selection.Presentation.Lesson.Code)
                                    </td>
                                    <td class="py-3 text-center">
                                        <span class="badge" style="background-color: #dee2e6; color: @textDark; border-radius: 20px;">
                                            @ToPersianNumber(selection.Presentation.Lesson.Unit)
                                        </span>
                                    </td>
                                    <td class="py-3 text-right">
                                        @selection.Presentation.Master.User.PersonInformation.FirstName
                                        @selection.Presentation.Master.User.PersonInformation.LastName
                                    </td>
                                    <td class="py-3 text-right">
                                        @selection.Presentation.DayHold<br>
                                        <small class="text-muted">
                                            @ToPersianNumber(selection.Presentation.StartTime.ToString("HH:mm")) - @ToPersianNumber(selection.Presentation.EndTime.ToString("HH:mm"))
                                        </small>
                                    </td>
                                    <td class="py-3 text-center">
                                        @if (selection.Score > 0)
                                        {
                                            <span class="badge text-white fw-bold" style="background-color: @successColor; border-radius: 20px;">
                                                @ToPersianNumber(selection.Score.ToString("F2"))
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-white" style="background-color: #6c757d; border-radius: 20px;">
                                                نیافتاده
                                            </span>
                                        }
                                    </td>
                                    @if (Model.IsSelectionTime)
                                    {
                                        <td class="py-3 text-center">
                                            <form method="post" action="@Url.Action("RemoveSelection")" style="display:inline;"
                                                  onsubmit="return showCustomConfirmation();">
                                                <input type="hidden" name="selectionId" value="@selection.Id" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger shadow-sm"
                                                        title="حذف این واحد">
                                                    <i class="fas fa-trash me-1"></i> حذف
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Footer Action Buttons -->
    <div class="mt-5 d-flex justify-content-end gap-3">
        <a href="@Url.Action("Selections")" class="btn fw-bold shadow-sm"
           style="background-color: @textLight; color: @primaryColor; border: 1px solid @primaryColor; border-radius: 8px;">
            <i class="fas fa-arrow-right me-1"></i>
            بازگشت به لیست واحدهای ترم
        </a>
        @if (Model.IsSelectionTime)
        {
            <a href="@Url.Action("RegisterSelection")" class="btn fw-bold shadow-sm"
               style="background-color: @accentColor; color: @textDark; border: none; border-radius: 8px;">
                <i class="fas fa-plus me-1"></i>
                انتخاب واحد جدید
            </a>
        }
    </div>
</div>

<!-- Custom Confirmation Modal/Message Placeholder (Replaces alert/confirm) -->
