    // Since native alert/confirm are forbidden, a full modal is required for proper confirmation.
    // For this single-file Razor view, we use a simple placeholder function and rely on the
    // fact that the server will handle the POST request. A proper app would show a Bootstrap modal here.
    function showCustomConfirmation() {
        // In a real application, you would launch a Bootstrap modal here and handle the confirmation.
        // For demonstration, we'll confirm submission immediately (or rely on UI feedback).
        console.log("Confirmation Dialog: Are you sure you want to remove this course?");
        return true; // Allows the form submission to proceed
    }
</script>