@model RegisterSelectionViewModel
@using MelliMaharat.Models.Enums

@{
    ViewData["Title"] = "انتخاب واحد";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>
                <i class="fas fa-plus-circle"></i>
                انتخاب واحد‌های جدید
            </h2>
            <p class="text-muted">
                ترم: @Model.CurrentTerm.Year - @(Model.CurrentTerm.Type == TermType.Fall ? "پاییز" : "بهار")
            </p>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Selections")" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i>
                بازگشت
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="alert alert-info mb-4">
        <i class="fas fa-info-circle me-2"></i>
        <strong>نکته:</strong> روی کارت‌های زیر کلیک کنید تا واحد را انتخاب کنید.
    </div>

    @if (!Model.AvailablePresentations.Any())
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            هیچ واحدی برای انتخاب موجود نیست.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var presentation in Model.AvailablePresentations.OrderBy(p => p.Lesson.Name))
            {
                var isSelected = Model.StudentSelections.Contains(presentation.Id);

                <div class="col-md-6 mb-3">
                    <div class="card h-100 @(isSelected ? "border-success border-2" : "")" style="cursor: pointer;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">@presentation.Lesson.Name</h5>
                                    <small class="text-muted">کد: @presentation.Lesson.Code</small>
                                </div>
                                <span class="badge bg-primary">@presentation.Lesson.Unit واحد</span>
                            </div>

                            <p class="mb-2">
                                <strong>استاد:</strong><br>
                                @presentation.Master.User.PersonInformation.FirstName
                                @presentation.Master.User.PersonInformation.LastName
                            </p>

                            <p class="mb-2">
                                <strong>روز و ساعت:</strong><br>
                                @presentation.DayHold، @presentation.StartTime.ToString("HH:mm") - @presentation.EndTime.ToString("HH:mm")
                            </p>

                            @if (presentation.ExamDate != DateOnly.MinValue)
                            {
                                <p class="mb-3">
                                    <strong>امتحان:</strong><br>
                                    @presentation.ExamDate.ToString("yyyy-MM-dd")
                                    در ساعت @presentation.ExamStartTime.ToString("HH:mm")
                                </p>
                            }

                            <form method="post" action="@Url.Action("RegisterSelection")" style="display: inline; width: 100%;">
                                <input type="hidden" name="presentationId" value="@presentation.Id" />
                                <input type="hidden" name="termId" value="@Model.CurrentTermId" />

                                @if (isSelected)
                                {
                                    <button type="submit" class="btn btn-success w-100" disabled>
                                        <i class="fas fa-check me-1"></i>
                                        انتخاب شده
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-outline-primary w-100">
                                        <i class="fas fa-plus me-1"></i>
                                        انتخاب این واحد
                                    </button>
                                }
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .card {
        border-right: 4px solid #0d6efd;
        transition: all 0.3s ease;
    }

        .card:hover {
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }

        .card.border-success {
            background-color: rgba(40, 167, 69, 0.05);
        }

    .badge {
        padding: 6px 12px;
        border-radius: 20px;
    }
</style>