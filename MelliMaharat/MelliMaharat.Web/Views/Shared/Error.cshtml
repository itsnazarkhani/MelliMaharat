@model ErrorViewModel
@{
    ViewData["Title"] = "خطا";
}

<div class="container py-5" dir="rtl">

    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">

                    <!-- Icon -->
                    <div class="text-center mb-4">
                        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
                    </div>

                    <!-- Title -->
                    <h2 class="text-center text-danger fw-bold mb-3">خطایی رخ داده است</h2>
                    <p class="text-center text-muted mb-4">
                        هنگام پردازش درخواست شما مشکلی پیش آمد. لطفاً دوباره تلاش کنید.
                    </p>

                    <!-- Request Id (only in development) -->
                    @if (Model?.ShowRequestId == true)
                    {
                        <div class="alert alert-secondary text-center">
                            <strong>شناسه درخواست: </strong>
                            <code>@Model.RequestId</code>
                        </div>
                    }

                    <!-- Suggestion -->
                    <div class="alert alert-info mt-4">
                        <h5 class="fw-bold">حالت توسعه (Development Mode)</h5>
                        <p class="mb-1">
                            فعال کردن حالت <strong>Development</strong> اطلاعات کامل‌تری از خطا نمایش می‌دهد.
                        </p>
                        <p class="small mb-0">
                            این حالت فقط برای محیط محلی مناسب است. در محیط‌های واقعی نباید فعال باشد.
                        </p>
                    </div>

                    <!-- Back Button -->
                    <div class="text-center mt-4">
                        <a href="/" class="btn btn-primary px-4">
                            بازگشت به صفحه اصلی
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>

</div>
