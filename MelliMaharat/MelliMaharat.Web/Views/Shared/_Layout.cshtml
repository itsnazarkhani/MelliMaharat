@using MelliMaharat.Models.Enums
@{
    var userModel = Context.Items["LayoutUser"] as LayoutUserViewModel;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ملی مهارت چمران</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <!-- Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Navbar Styles -->
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />

    <style>
        /* Layout Structure */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        header {
            flex-shrink: 0;
        }

        main {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        footer {
            flex-shrink: 0;
        }

        .container-fluid {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
    </style>
</head>

<body>
    <!-- Header with Navbar -->
    <header>
        @await Html.PartialAsync("_Navbar")
    </header>

    <!-- Main Content -->
    <div class="container-fluid">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white mt-auto py-3">
        <div class="container-fluid text-center">
            <p class="mb-0">
                <i class="fas fa-copyright"></i> 1404
                <strong>دانشکده ملی مهارت چمران</strong> - تمام حقوق محفوظ است
            </p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>