@model List<PresentedLessonViewModel>
@{
    ViewData["Title"] = "کلاس‌های ارائه شده";

    // Define theme colors for the design, consistent with other Admin pages
    var primaryColor = "#004488"; // Deep Corporate Blue
    var accentColor = "#0056b3";  // Slightly darker primary for hover
    var secondaryColor = "#6c757d"; // Gray
    var infoColor = "#17a2b8"; // Info Blue for badges
    var infoAccent = "#117a8b";

    // *******************************************************************
    // NOTE: This helper function is assumed to be available in the context.
    // This is the implementation logic for demonstrating Persian numbers:
    // *******************************************************************
    string ToPersianNumber(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        return input.Replace('0', '۰').Replace('1', '۱').Replace('2', '۲')
                    .Replace('3', '۳').Replace('4', '۴').Replace('5', '۵')
                    .Replace('6', '۶').Replace('7', '۷').Replace('8', '۸')
                    .Replace('9', '۹');
    }
}

<style>
    /*
         * Styling for the body element is avoided as requested.
         */

    .page-header {
        color: @primaryColor;
        font-weight: 800;
        border-bottom: 3px solid @primaryColor;
        padding-bottom: 10px;
        margin-bottom: 30px;
        display: inline-block;
        width: 100%;
    }

    /* --- Table Styling --- */
    .table-container {
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        overflow-x: auto; /* Ensures responsiveness on small screens */
        background-color: white;
        border: 1px solid #e9ecef;
    }

    .table-styled {
        margin: 0;
        width: 100%;
        min-width: 700px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-styled thead {
            background-color: @primaryColor;
            color: white;
        }

        .table-styled th {
            font-weight: 600;
            padding: 15px 12px;
            text-align: right;
            border: none;
            vertical-align: middle;
            font-size: 0.95rem;
        }

            .table-styled th:last-child {
                text-align: center; /* Operations column */
            }

        .table-styled td {
            padding: 12px;
            border-top: 1px solid #f1f1f1;
            text-align: right;
            vertical-align: middle;
            /* Ensure Persian font is used for correct rendering of numbers */
            font-family: Tahoma, 'B Titr', 'B Nazanin', Arial, sans-serif;
        }

            .table-styled td:last-child {
                text-align: center; /* Operations column */
            }

        .table-styled tbody tr:hover {
            background-color: #f7f9fc;
            cursor: default;
        }

    /* Badge for DayHold */
    .badge-info-styled {
        background-color: @infoColor !important;
        color: white;
        font-weight: bold;
        padding: 6px 10px;
        border-radius: 6px;
    }

    /* Session Button Styling */
    .btn-session-styled {
        background-color: @primaryColor;
        border-color: @primaryColor;
        color: white;
        font-weight: 500;
        padding: 6px 15px;
        border-radius: 6px;
        transition: all 0.2s;
        font-size: 0.9rem;
    }

        .btn-session-styled:hover {
            background-color: @accentColor;
            border-color: @accentColor;
        }

    /* Empty State Alert */
    .alert-info-styled {
        background-color: #e2f3ff;
        border-color: #b8e2f8;
        color: #004488;
        border-radius: 10px;
        padding: 15px;
        font-weight: 500;
    }
</style>

<div class="container py-5" dir="rtl">

    <h2 class="page-header">
        <i class="fas fa-book-open ms-2"></i>
        کلاس‌های ارائه شده
    </h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info-styled" role="alert">
            <i class="fas fa-info-circle ms-2"></i>
            هیچ کلاسی برای این دوره یافت نشد.
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="table table-styled">
                <thead>
                    <tr>
                        <th>درس</th>
                        <th>روز</th>
                        <th>ساعت شروع</th>
                        <th>ساعت پایان</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lesson in Model)
                    {
                        <tr>
                            <td>
                                <strong>@lesson.LessonName</strong>
                            </td>
                            <td>
                                <span class="badge badge-info-styled">@lesson.DayHold</span>
                            </td>

                            <!-- Convert Time strings to Persian numbers -->
                            <td>
                                @ToPersianNumber(lesson.StartTime.ToString())
                            </td>
                            <td>
                                @ToPersianNumber(lesson.EndTime.ToString())
                            </td>

                            <td>
                                <a class="btn btn-sm btn-session-styled"
                                   asp-action="Sessions"
                                   asp-route-presentationId="@lesson.PresentationId"
                                   title="مشاهده جلسات">
                                    <i class="fas fa-calendar-check ms-1"></i> جلسات
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>