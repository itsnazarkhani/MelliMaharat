@model AttendanceViewModel
@{
    ViewData["Title"] = "ثبت حضور و غیاب";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col">
            <h2 class="text-primary">
                <i class="bi bi-check-square"></i> ثبت حضور و غیاب
            </h2>
        </div>
    </div>

    @if (Model == null || !Model.Items.Any())
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> هیچ دانشجویی یافت نشد.
        </div>
    }
    else
    {
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle"></i> خطا در ثبت اطلاعات
                @Html.ValidationSummary(false, "", new { @class = "mt-2" })
            </div>
        }

        <form asp-action="TakeAttendance" method="post" class="needs-validation" novalidate>
            <input type="hidden" asp-for="SessionId" />
            <input type="hidden" asp-for="PresentationId" />

            @if (Model.Items.Any())
            {
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="text-align: right; width: 70%;">نام دانشجو</th>
                                        <th style="text-align: center; width: 30%;">حضور</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Items.Count; i++)
                                    {
                                        <tr>
                                            <td style="text-align: right;">
                                                @Model.Items[i].StudentName
                                                <!-- Hidden fields for model binding -->
                                                <input asp-for="Items[i].SelectionId" type="hidden" />
                                                <input asp-for="Items[i].AttendanceId" type="hidden" />
                                                <input asp-for="Items[i].StudentName" type="hidden" />
                                            </td>
                                            <td style="text-align: center;">
                                                <div class="form-check form-switch d-flex justify-content-center">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           asp-for="Items[i].HasAttended"
                                                           id="attendance_@i"
                                                           style="transform: scale(1.5);" />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-check-circle"></i> ثبت حضور و غیاب
                    </button>
                    <a asp-action="Sessions"
                       asp-route-presentationId="@Model.PresentationId"
                       class="btn btn-secondary btn-lg">
                        <i class="bi bi-arrow-right"></i> بازگشت
                    </a>
                </div>
            }
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}