@model GradesSummaryViewModel
@{
    ViewData["Title"] = "خلاصه نمرات";
}

<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col">
            <h2 class="text-primary">
                <i class="bi bi-list-check"></i> خلاصه نمرات
            </h2>
            <p class="text-muted">
                درس: <strong>@Model.LessonName</strong>
            </p>
        </div>
        <div class="col-auto">
            <a class="btn btn-success" asp-action="ExportGrades" asp-route-presentationId="@Model.PresentationId">
                <i class="bi bi-download"></i> صادرات CSV
            </a>
            <a asp-action="SubmitGrades" asp-route-presentationId="@Model.PresentationId" class="btn btn-primary">
                <i class="bi bi-pencil"></i> ویرایش
            </a>
            <a asp-action="GradeManagement" class="btn btn-secondary">
                <i class="bi bi-arrow-right"></i> بازگشت
            </a>
        </div>
    </div>

    @{
        var gradesStats = Model.Items.Where(i => i.IsGraded).ToList();
        var avgGrade = gradesStats.Any() ? Math.Round(gradesStats.Average(i => i.Grade), 2) : 0;
        var maxGrade = gradesStats.Any() ? Math.Round(gradesStats.Max(i => i.Grade), 2) : 0;
        var minGrade = gradesStats.Any() ? Math.Round(gradesStats.Min(i => i.Grade), 2) : 0;
    }

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">میانگین</h5>
                    <h2 class="text-primary">@avgGrade</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">بیشترین</h5>
                    <h2 class="text-success">@maxGrade</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">کمترین</h5>
                    <h2 class="text-danger">@minGrade</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">نمرات ثبت شده</h5>
                    <h2 class="text-info">@Model.Items.Count(i => i.IsGraded)/@Model.Items.Count</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-table"></i> جدول نمرات
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="text-align: right; width: 70%;">نام دانشجو</th>
                            <th style="text-align: center; width: 20%;">نمره</th>
                            <th style="text-align: center; width: 10%;">وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td style="text-align: right;">
                                    @item.StudentName
                                </td>
                                <td style="text-align: center;">
                                    @if (item.IsGraded)
                                    {
                                        <span class="badge bg-success">
                                            @item.Grade.ToString("F2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            بدون نمره
                                        </span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    @if (item.IsGraded)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>