@model SetScoreViewModel
@{
    ViewData["Title"] = "ثبت نمره";

    // Define theme colors for consistency
    var primaryColor = "#004488"; // Deep Corporate Blue
    var secondaryColor = "#7f8c8d"; // Gray for Back button
}

@functions {
    /// <summary>
    /// Converts Latin (English) numerals in a string to Persian (Farsi) numerals.
    /// </summary>
    public string ToPersianNumber(object input)
    {
        if (input == null) return string.Empty;
        string text = input.ToString();

        Dictionary<char, char> mapping = new Dictionary<char, char>
        {
            {'0', '۰'}, {'1', '۱'}, {'2', '۲'}, {'3', '۳'}, {'4', '۴'},
            {'5', '۵'}, {'6', '۶'}, {'7', '۷'}, {'8', '۸'}, {'9', '۹'},
            {'.', '/'} // Handle decimal point for scores
        };

        char[] chars = text.ToCharArray();
        for (int i = 0; i < chars.Length; i++)
        {
            if (mapping.ContainsKey(chars[i]))
            {
                chars[i] = mapping[chars[i]];
            }
        }
        return new string(chars);
    }
}

<style>
    /* --- General Styling and Consistent Rounding --- */
    :root {
        --mm-border-radius: 12px; /* Consistent rounding value */
        --primary-color: @primaryColor;
        --secondary-color: @secondaryColor;
    }

    .card-score {
        border-radius: var(--mm-border-radius);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        border: none;
        overflow: hidden;
    }

    .card-header-styled {
        background-color: var(--primary-color) !important;
        padding: 20px;
        border-bottom: none;
        color: white;
        font-weight: 700;
        font-size: 1.25rem;
    }

    /* --- Form Elements --- */
    .form-control, .btn {
        border-radius: 8px;
    }

    .form-control-lg {
        height: 55px;
        font-size: 1.2rem;
        font-weight: 700;
        /* Ensure input direction is LTR for numbers but text alignment is right */
        direction: ltr;
        text-align: right;
    }

    .form-label strong {
        font-weight: 600;
        color: #34495e;
    }

    .disabled-input {
        background-color: #f5f8fb;
        font-weight: 600;
        color: #7f8c8d;
    }

    /* --- Buttons --- */
    .btn-lg {
        padding: 12px 20px;
        font-size: 1.1rem;
        font-weight: 700;
        transition: all 0.2s;
    }

    .btn-primary-styled {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }

        .btn-primary-styled:hover {
            background-color: #003366;
            border-color: #003366;
        }

    .btn-secondary-styled {
        background-color: var(--secondary-color);
        border-color: var(--secondary-color);
    }

        .btn-secondary-styled:hover {
            background-color: #6c7a81;
            border-color: #6c7a81;
        }

    .text-muted-styled {
        color: #95a5a6 !important;
        font-weight: 500;
    }
</style>

<div class="container py-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card card-score">
                <div class="card-header card-header-styled text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-star ms-2"></i> ثبت نمره
                    </h4>
                </div>
                <div class="card-body p-4">

                    <form asp-action="SetScore" method="post" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="SelectionId" />

                        <!-- Student Name (Disabled) -->
                        <div class="mb-3">
                            <label for="studentName" class="form-label">
                                <strong>نام دانشجو</strong>
                            </label>
                            <input type="text"
                                   id="studentName"
                                   class="form-control disabled-input"
                                   value="@Model.StudentName"
                                   disabled
                                   style="text-align: right;" />
                        </div>

                        <!-- Current Score (Disabled and Persianized) -->
                        <div class="mb-3">
                            <label for="currentScore" class="form-label">
                                <strong>نمره فعلی</strong>
                            </label>
                            <input type="text"
                                   id="currentScore"
                                   class="form-control disabled-input text-primary"
                                   value="@ToPersianNumber(Model.CurrentScore.ToString("F2"))"
                                   disabled
                                   style="text-align: right; font-size: 1.1rem; color: var(--primary-color)!important;" />
                        </div>

                        <!-- New Score Input -->
                        <div class="mb-4">
                            <label asp-for="NewScore" class="form-label">
                                <strong>نمره جدید</strong>
                            </label>
                            <input asp-for="NewScore"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   max="20"
                                   class="form-control form-control-lg"
                                   placeholder="نمره را وارد کنید (0-20)"
                                   required
                                   autofocus />
                            <small class="form-text text-muted-styled d-block mt-2">
                                نمره باید بین ۰ تا ۲۰ باشد.
                            </small>
                            <span asp-validation-for="NewScore" class="text-danger"></span>
                        </div>

                        <!-- Validation Summary -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger mb-4" role="alert" style="border-radius: 8px;">
                                @Html.ValidationSummary(false)
                            </div>
                        }

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2">
                            <a asp-action="GradeManagement"
                               class="btn btn-secondary btn-lg btn-secondary-styled flex-grow-1">
                                <i class="fas fa-arrow-right ms-2"></i> بازگشت
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg btn-primary-styled flex-grow-1">
                                <i class="fas fa-check-circle ms-2"></i> ثبت نمره
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}