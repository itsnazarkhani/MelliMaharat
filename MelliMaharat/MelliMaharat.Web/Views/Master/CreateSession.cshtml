@model CreateSessionViewModel
@{
    ViewData["Title"] = "ایجاد جلسه جدید";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-calendar-plus"></i> ایجاد جلسه جدید
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreateSession" method="post" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="PresentationId" />

                        <div class="mb-4">
                            <label asp-for="SessionDate" class="form-label">
                                <strong>تاریخ جلسه</strong>
                            </label>
                            <input asp-for="SessionDate"
                                   type="date"
                                   class="form-control form-control-lg"
                                   required
                                   style="text-align: right;" />
                            <small class="form-text text-muted d-block mt-2">
                                تاریخ جلسه نمی‌تواند قبل از امروز باشد
                            </small>
                            <span asp-validation-for="SessionDate" class="text-danger"></span>
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger" role="alert">
                                @Html.ValidationSummary(false)
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success btn-lg flex-grow-1">
                                <i class="bi bi-plus-circle"></i> ایجاد جلسه
                            </button>
                            <a asp-action="Sessions"
                               asp-route-presentationId="@Model.PresentationId"
                               class="btn btn-secondary btn-lg flex-grow-1">
                                <i class="bi bi-arrow-right"></i> بازگشت
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-3 alert alert-info" role="alert">
                <i class="bi bi-info-circle"></i>
                <strong>توجه:</strong> جلسه برای تمام دانشجویان ثبت‌نام‌شده در این کلاس ایجاد خواهد شد.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}