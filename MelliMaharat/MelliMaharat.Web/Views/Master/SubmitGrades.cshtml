@model SubmitGradesViewModel
@{
    ViewData["Title"] = "ثبت نمرات";
}

<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col">
            <h2 class="text-primary">
                <i class="bi bi-pencil-square"></i> ثبت نمرات
            </h2>
            <p class="text-muted">
                درس: <strong>@Model.LessonName</strong>
            </p>
        </div>
        <div class="col-auto">
            <a asp-action="GradeManagement" class="btn btn-secondary">
                <i class="bi bi-arrow-right"></i> بازگشت
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> <strong>خطا در ثبت نمرات</strong>
            @Html.ValidationSummary(false)
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">کل دانشجویان</h5>
                    <h2 class="text-primary">@Model.TotalStudents</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">نمرات ثبت شده</h5>
                    <h2 class="text-success">@Model.GradesSubmitted</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">میانگین نمرات</h5>
                    <h2 class="text-info">@Model.AverageGrade</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">درصد تکمیل</h5>
                    <h2 class="text-warning">
                        @{
                            var percentage = Model.TotalStudents > 0
                            ? Math.Round((Model.GradesSubmitted * 100m) / Model.TotalStudents, 0)
                            : 0;
                        }
                        @percentage%
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Grades Form -->
    <form asp-action="SubmitGrades" method="post" class="needs-validation" novalidate>
        <input type="hidden" asp-for="PresentationId" />
        <input type="hidden" asp-for="LessonName" />

        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-table"></i> جدول نمرات
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="text-align: right; width: 40%;">نام دانشجو</th>
                                <th style="text-align: center; width: 20%;">نمره فعلی</th>
                                <th style="text-align: center; width: 20%;">نمره جدید</th>
                                <th style="text-align: center; width: 20%;">تغییر</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                @for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    <tr>
                                        <td style="text-align: right; vertical-align: middle;">
                                            @Model.Items[i].StudentName
                                            <input asp-for="Items[i].SelectionId" type="hidden" />
                                            <input asp-for="Items[i].StudentName" type="hidden" />
                                        </td>
                                        <td style="text-align: center; vertical-align: middle;">
                                            <span class="badge bg-info">
                                                @Model.Items[i].CurrentScore.ToString("F2")
                                            </span>
                                        </td>
                                        <td style="text-align: center; vertical-align: middle;">
                                            <input asp-for="Items[i].NewScore"
                                                   type="number"
                                                   step="0.01"
                                                   min="0"
                                                   max="20"
                                                   class="form-control form-control-sm text-center grade-input"
                                                   placeholder="0"
                                                   data-original="@Model.Items[i].CurrentScore" />
                                            <span asp-validation-for="Items[i].NewScore" class="text-danger small"></span>
                                        </td>
                                        <td style="text-align: center; vertical-align: middle;">
                                            <span class="badge bg-secondary grade-status" data-index="@i">
                                                بدون تغییر
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        هیچ دانشجویی یافت نشد
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-check-circle"></i> ثبت نمرات
            </button>
            <button type="reset" class="btn btn-warning btn-lg">
                <i class="bi bi-arrow-clockwise"></i> تنظیم مجدد
            </button>
            <a asp-action="GradeManagement" class="btn btn-secondary btn-lg">
                <i class="bi bi-arrow-right"></i> بازگشت
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const gradeInputs = document.querySelectorAll('.grade-input');

            gradeInputs.forEach((input, index) => {
                const originalValue = parseFloat(input.getAttribute('data-original'));

                input.addEventListener('change', function() {
                    const newValue = parseFloat(this.value) || 0;
                    const statusBadge = document.querySelector(`.grade-status[data-index="${index}"]`);

                    if (newValue === originalValue) {
                        statusBadge.textContent = 'بدون تغییر';
                        statusBadge.className = 'badge bg-secondary grade-status';
                    } else if (newValue > originalValue) {
                        statusBadge.textContent = `+ ${(newValue - originalValue).toFixed(2)}`;
                        statusBadge.className = 'badge bg-success grade-status';
                    } else {
                        statusBadge.textContent = `- ${(originalValue - newValue).toFixed(2)}`;
                        statusBadge.className = 'badge bg-danger grade-status';
                    }
                });
            });
        });
    </script>
}