<Window x:Class="MelliMaharat.Wpf.Windows.Dialogs.RoleSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MelliMaharat.Wpf.Windows.Dialogs"
        mc:Ignorable="d"
        Title="RoleSelectionDialog"
        Height="200"
        Width="350"
        Background="Transparent"
        FontFamily="{StaticResource SFProRounded}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None">
    
    <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinHeight="150"
                MinWidth="260"
                Background="White"
                CornerRadius="20">

        <Border.Effect>
            <DropShadowEffect ShadowDepth="0"
                              BlurRadius="30"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4*"/>
            </Grid.RowDefinitions>
            <Border Background="Transparent"
                    MouseDown="Border_MouseDown">
                
            </Border>
            <TextBlock Grid.Column="0"
                       Panel.ZIndex="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       FontSize="16"
                       Margin="17 10 0 0"
                       FontWeight="Bold">
                <Hyperlink TextDecorations="None" Click="Cancel_Hyperlink_Click">Cancel</Hyperlink>
            </TextBlock>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="1.5*"/>
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="20" Text="Select Your Role"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock FontSize="15"
                               Opacity="0.75"
                               Margin="0 5 0 0"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Text="Are You Student or Master?"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0 0 0 10">

                    <Button Height="40"
                            Width="40"
                            Click="btnStudent_Click"
                            Name="btnStudent"
                            Content="Student"
                            Margin="15 15 7.5 0"/>

                    <Button Height="40"
                            Width="50"
                            Click="btnMaster_Click"
                            Name="btnMaster"
                            Content="Master"
                            Margin="7.5 15 15 0"/>

                </StackPanel>
                
            </Grid>
        </Grid>
    </Border>
</Window>
