<Page x:Class="MelliMaharat.Wpf.Windows.Pages.Manager.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MelliMaharat.Wpf.Windows.Pages.Manager"
      xmlns:custom="clr-namespace:MelliMaharat.Wpf.Resources.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="593"
      Name="Root">

    <Grid Margin="15">


        <Grid>


            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Profile" FontSize="30" FontWeight="Bold"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                <DockPanel Margin="15">
                    <Grid DockPanel.Dock="Top">
                        <Ellipse Style="{StaticResource Profile_Outer_Ellipse}"/>
                        <Ellipse Style="{StaticResource Profile_Inner_Ellipse}" Fill="{StaticResource ManagerIconBrush}"/>
                    </Grid>
                    <custom:CustomTextBox Tag="First Name:"
                                          InputText="{Binding FirstName}"
                                          DockPanel.Dock="Top"/>

                    <custom:CustomTextBox Tag="Last Name:"
                                          InputText="{Binding LastName}"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox Tag="Password:"
                                          InputText="{Binding Password}"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox Tag="Email:"
                                          InputText="{Binding Email}"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox Tag="Birth Date:"
                                          InputText="{Binding BirthDate}"
                                          DockPanel.Dock="Top"/>

                    <custom:CustomTextBox Tag="National Code:"
                                          InputText="{Binding NationalCode}"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox Tag="Phone Number:"
                                          InputText="{Binding PhoneNumber}"
                                          DockPanel.Dock="Top"/>

                    <custom:CustomTextBox Tag="Username:"
                                          InputText="{Binding Username}"
                                          DockPanel.Dock="Top"/>
                    
                    <custom:CustomTextBox Tag="Is Admin:"
                                          InputText="{Binding IsAdmin}"
                                          DockPanel.Dock="Top"/>

                    <custom:CustomTextBox Tag="Id:"
                                          InputText="{Binding Id}"
                                          IsEnabled="False"
                                          DockPanel.Dock="Top"/>

                    <WrapPanel HorizontalAlignment="Center" DockPanel.Dock="Bottom">
                        <Button Content="Update Profile" Command="{Binding UpdateCommand}"/>
                    </WrapPanel>
                </DockPanel>
            </ScrollViewer>

        </Grid>


    </Grid>


</Page>
