<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Images -->
    <Image x:Key="ExitImage"
       Source="/Resources/Images/icons8-close-48.png"
       RenderTransformOrigin="0.5 0.5">
        <Image.RenderTransform>
            <ScaleTransform ScaleX="0.65" ScaleY="0.65"/>
        </Image.RenderTransform>
    </Image>
    <Image x:Key="MinimizeImage"
       Source="/Resources/Images/icons8-minus-48.png"
       RenderTransformOrigin="0.5 0.5"
       SnapsToDevicePixels="False">
        <Image.RenderTransform>
            <ScaleTransform ScaleX="0.6" ScaleY="0.48"/>
        </Image.RenderTransform>
    </Image>
    <Image x:Key="ManagerIcon"
       Source="/Resources/Images/Manager.jpg"
       SnapsToDevicePixels="False"
       RenderTransformOrigin="0.5 0.5">

    </Image>
    <Image x:Key="MasterIcon"
       Source="/Resources/Images/Master.jpg"
       SnapsToDevicePixels="False"
       RenderTransformOrigin="0.5 0.5">

    </Image>
    <Image x:Key="StudentIcon"
       Source="/Resources/Images/Student.jpg"
       SnapsToDevicePixels="True"
       RenderTransformOrigin="0.5 0.5">

    </Image>

    <!-- Image Brushes-->
    <ImageBrush x:Key="ManagerIconBrush" ImageSource="/Resources/Images/Manager.jpg"/>
    <ImageBrush x:Key="MasterIconBrush" ImageSource="/Resources/Images/Master.jpg">
        <ImageBrush.Transform>
            <TranslateTransform X="-1" Y="-1"/>
        </ImageBrush.Transform>
    </ImageBrush>
    <ImageBrush x:Key="StudentIconBrush" ImageSource="/Resources/Images/Student.jpg"/>

</ResourceDictionary>