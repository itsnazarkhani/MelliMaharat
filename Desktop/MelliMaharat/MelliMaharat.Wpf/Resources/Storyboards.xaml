<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   
    <!-- Storyboards -->
    <Storyboard x:Key="btnSignInMouseEnterStoryBoard"
                Storyboard.TargetName="btnSignInGlowAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="1"
                         Duration="0:0:0.2">
        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="btnSignInMouseLeaveStoryBoard"
                Storyboard.TargetName="btnSignInGlowAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         To="0"
                         Duration="0:0:0.2">
        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="RoleSelectionDialogBoxButtonStudentDropShadowEffectGlowBegin"
                Storyboard.TargetName="RoleSelectionDialogBoxButtonStudentDropShadowEffect"
                Storyboard.TargetProperty="Opacity">
        <DoubleAnimation To="1"
                         Duration="0:0:0.2">

        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="RoleSelectionDialogBoxButtonStudentDropShadowEffectGlowEnd"
                Storyboard.TargetName="RoleSelectionDialogBoxButtonStudentDropShadowEffect"
                Storyboard.TargetProperty="Opacity">
        <DoubleAnimation To="0"
                         Duration="0:0:0.2">

        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="RoleSelectionDialogBoxButtonMasterDropShadowEffectGlowBegin"
                Storyboard.TargetName="RoleSelectionDialogBoxButtonMasterDropShadowEffect"
                Storyboard.TargetProperty="Opacity">
        <DoubleAnimation To="1"
                         Duration="0:0:0.2">

        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="RoleSelectionDialogBoxButtonMasterDropShadowEffectGlowEnd"
                Storyboard.TargetName="RoleSelectionDialogBoxButtonMasterDropShadowEffect"
                Storyboard.TargetProperty="Opacity">
        <DoubleAnimation To="0"
                         Duration="0:0:0.2">

        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="lblTagFadeOut">

        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].X"
                     To="-10"
                     Duration="0:0:0.2"/>

        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     To="0"
                     Duration="0:0:0.2"/>
    </Storyboard>
    <Storyboard x:Key="lblTagFadeIn">
        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].X"
                     To="0"
                     Duration="0:0:0.2"/>

        <DoubleAnimation Storyboard.TargetProperty="Opacity"
             To="1"
             Duration="0:0:0.2"/>
    </Storyboard>
    <Storyboard x:Key="UserControlBorderGotFocusStoryboard"
            Storyboard.TargetName="borderShadow">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
             To="1"
             Duration="0:0:0.2">
        </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="UserControlBorderLostFocusStoryboard"
            Storyboard.TargetName="borderShadow">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
             To="0"
             Duration="0:0:0.2">
        </DoubleAnimation>
    </Storyboard>

</ResourceDictionary>